-- Secure V1 on a real multi-participant Canton topology (`multi-participant/canton.conf`), one
-- participant per role. Run only through `scripts/run-multi-participant.sh`; every script here
-- takes an argument so `dpm test` does not run it against the IDE ledger.
--
-- A Canton submission must come from a participant hosting every `actAs` party, so every
-- multi-signatory step goes through the production workflows of
-- `CantonTreasuryAmm.SecureV1.Onboarding` and `CantonTreasuryAmm.SecureV1.Pause`, each signer
-- submitting from its own participant.
-- `GovernanceProxy` below is an attack fixture, not an approval mechanism.
module CantonTreasuryAmm.Test.MultiParticipant where

import DA.Action ((>=>), unless)
import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.List (sortOn, unique)
import DA.Optional (fromSome, isNone, isSome)
import DA.Text (isInfixOf)
import DA.Time (milliseconds)
import Daml.Script

import CantonTreasuryAmm.Errors
import CantonTreasuryAmm.Pool qualified as Legacy
import CantonTreasuryAmm.SecureV1.Errors
import CantonTreasuryAmm.SecureV1.Onboarding
import CantonTreasuryAmm.SecureV1.Pause
import CantonTreasuryAmm.SecureV1.Pool
import CantonTreasuryAmm.SecureV1.SwapIntent
import CantonTreasuryAmm.Test.Fixtures
import CantonTreasuryAmm.Test.MigrationRehearsal
import CantonTreasuryAmm.Test.ProtectedPoolPrototypeTests qualified as Prototype
import CantonTreasuryAmm.Test.ProtectedPoolSettlementTests qualified as Settlement
import CantonTreasuryAmm.Test.SecureV1Attacks (assertInvisibleActive)
import CantonTreasuryAmm.Test.SecureV1Support
import CantonTreasuryAmm.Token
import CantonTreasuryAmm.Types

-- Governance lends the operator its authority for anything: the strongest operator and
-- governance collusion that involves neither the custodian nor an issuer.
template GovernanceProxy
  with
    operator : Party
    governance : Party
  where
    signatory governance
    observer operator

    nonconsuming choice ProxyArchiveReserve : ()
      with
        reserveCid : ContractId SecureReserveHolding
      controller operator
      do archive reserveCid

    nonconsuming choice ProxyArchivePool : ()
      with
        poolCid : ContractId SecurePool
      controller operator
      do archive poolCid

    nonconsuming choice ProxyCreatePool : ContractId SecurePool
      with
        pool : SecurePool
      controller operator
      do create pool

    nonconsuming choice ProxyMintPosition : ContractId SecureLiquidityPosition
      with
        position : SecureLiquidityPosition
      controller operator
      do create position

    nonconsuming choice ProxySwapAsTrader : SecureSwapResult
      with
        poolCid : ContractId SecurePool
        trader : Party
        inputHoldingCid : ContractId Holding
        inputAmount : Decimal
        deadline : Time
        expectedVersion : Int
      controller operator
      do
        exercise poolCid SwapExactInput with
          trader
          direction = TreasuryForStable
          inputHoldingCid
          inputAmount
          minimumAmountOut = 0.0
          deadline
          expectedVersion

data MpParties = MpParties with
  custodian : Party
  operator : Party
  governance : Party
  treasuryIssuer : Party
  stableIssuer : Party
  trader : Party
  provider : Party
  auditor : Party
    deriving (Eq, Show)

-- Participant names as in `multi-participant/canton.conf` and the participant config.
hostingPlan : MpParties -> [(Text, Party)]
hostingPlan parties =
  [ ("custodian", parties.custodian)
  , ("operator", parties.operator)
  , ("governance", parties.governance)
  , ("treasury_issuer", parties.treasuryIssuer)
  , ("stable_issuer", parties.stableIssuer)
  , ("trader", parties.trader)
  , ("provider", parties.provider)
  , ("auditor", parties.auditor)
  ]

allParties : MpParties -> [Party]
allParties parties = map snd (hostingPlan parties)

data MpState = MpState with
  parties : MpParties
  lineage : SecureLineage
  treasuryInstrumentCid : ContractId TokenInstrument
  stableInstrumentCid : ContractId TokenInstrument
  charterCid : ContractId SecurePoolCharter
  initialized : SecureInitializeResult
  poolCid : ContractId SecurePool
    deriving (Eq, Show)

-- A proposal every core signer has approved but nobody has finalized.
data MpOutage = MpOutage with
  state : MpState
  terms : SecurePoolTerms
  proposalCid : ContractId SecurePoolProposal
    deriving (Eq, Show)

data MpLiveness = MpLiveness with
  outage : MpOutage
  inputCid : ContractId Holding
    deriving (Eq, Show)

-- The shared Secure V1 checks take a `SecureMarket`. `other` and `secondProvider` are not read
-- by those checks.
marketOf : MpState -> SecureMarket
marketOf state = SecureMarket with
  fixture = Fixture with
    treasuryIssuer = state.parties.treasuryIssuer
    stableIssuer = state.parties.stableIssuer
    operator = state.parties.operator
    governance = state.parties.governance
    provider = state.parties.provider
    trader = state.parties.trader
    other = state.parties.auditor
    auditor = state.parties.auditor
    treasuryInstrument = state.lineage.treasuryInstrument
    stableInstrument = state.lineage.stableInstrument
    treasuryInstrumentCid = state.treasuryInstrumentCid
    stableInstrumentCid = state.stableInstrumentCid
  custodian = state.parties.custodian
  secondProvider = state.parties.provider
  lineage = state.lineage
  charterCid = state.charterCid
  initialized = state.initialized

-- Each participant applies a committed transaction on its own, so a read on a participant other
-- than the submitter's first waits for that transaction.
poll : Text -> Int -> Script Bool -> Script ()
poll what attempts probe = do
  done <- probe
  unless done $
    if attempts <= 0
      then abort ("Participants did not converge: " <> what)
      else do
        sleep (milliseconds 250)
        poll what (attempts - 1) probe

awaitActive : (Template t, HasEnsure t) => [Party] -> ContractId t -> Script ()
awaitActive readers cid = forA_ readers $ \reader ->
  poll ("active " <> show cid <> " for " <> show reader) 120 (isSome <$> queryContractId reader cid)

awaitArchived : (Template t, HasEnsure t) => [Party] -> ContractId t -> Script ()
awaitArchived readers cid = forA_ readers $ \reader ->
  poll ("archived " <> show cid <> " for " <> show reader) 120 (isNone <$> queryContractId reader cid)

-- Every role that sees pool states. A transaction is applied atomically on each participant, so
-- once each of them sees the new state it has applied the whole transaction.
poolReaders : SecureMarket -> [Party]
poolReaders market =
  [ market.custodian
  , market.fixture.operator
  , market.fixture.governance
  , market.fixture.treasuryIssuer
  , market.fixture.stableIssuer
  , market.fixture.auditor
  ]

-- Issued on the issuer's participant; returns once the owner's and auditor's participants have it.
issueFrom : Party -> ContractId TokenInstrument -> Party -> Party -> Int -> Script (ContractId Holding)
issueFrom issuer instrumentCid auditor owner atoms = do
  holdingCid <- submit issuer $ exerciseCmd instrumentCid Issue with owner; amount = amountOf atoms
  awaitActive [owner, auditor] holdingCid
  pure holdingCid

issue : SecureMarket -> InstrumentId -> Party -> Int -> Script (ContractId Holding)
issue market instrument owner atoms = do
  let instrumentCid =
        if instrument == market.lineage.treasuryInstrument
          then market.fixture.treasuryInstrumentCid
          else market.fixture.stableInstrumentCid
  issueFrom instrument.issuer instrumentCid market.fixture.auditor owner atoms

feeFor : Int -> Int
feeFor inputAtoms = (inputAtoms * 3 + 999) / 1000

coreParties : MpParties -> [Party]
coreParties parties = [parties.custodian, parties.operator, parties.treasuryIssuer, parties.stableIssuer]

termsFor : MpParties -> SecureLineage -> Text -> Script SecurePoolTerms
termsFor parties lineage charterReference = do
  expiresAt <- futureDeadline
  pure SecurePoolTerms with
    lineage = lineage with charterReference
    initialProvider = parties.provider
    auditors = [parties.auditor]
    expiresAt

charterFor : SecurePoolTerms -> SecurePoolCharter
charterFor terms = SecurePoolCharter with
  lineage = terms.lineage
  initialProvider = terms.initialProvider
  auditors = terms.auditors

-- The operator proposes on its own participant; every core participant then sees the proposal.
mpPropose : MpParties -> SecurePoolTerms -> Script (ContractId SecurePoolProposal)
mpPropose parties terms = do
  proposalCid <- submit parties.operator $ createCmd SecurePoolProposal with terms; approvals = [parties.operator]
  awaitActive (coreParties parties) proposalCid
  pure proposalCid

-- One core signer approves on its own participant. The successor carries the same terms and
-- exactly the previous signatures plus the approver's.
mpApprove : MpParties -> Party -> SecurePoolTerms -> ContractId SecurePoolProposal -> Script (ContractId SecurePoolProposal)
mpApprove parties approver terms proposalCid = do
  Some proposal <- queryContractId approver proposalCid
  nextCid <- submit approver $ exerciseCmd proposalCid ApprovePoolProposal with approver; expectedTerms = terms
  awaitActive (coreParties parties) nextCid
  awaitArchived (coreParties parties) proposalCid
  Some next <- queryContractId parties.operator nextCid
  next === SecurePoolProposal with terms; approvals = proposal.approvals ++ [approver]
  pure nextCid

-- The operator finalizes on its own participant into exactly the proposed charter, which every
-- core signer, governance, the provider and the auditor then see.
mpFinalize : MpParties -> SecurePoolTerms -> ContractId SecurePoolProposal -> Script (ContractId SecurePoolCharter)
mpFinalize parties terms proposalCid = do
  charterCid <- submit parties.operator $ exerciseCmd proposalCid FinalizePoolProposal with expectedTerms = terms
  let readers = coreParties parties ++ [parties.governance, parties.provider, parties.auditor]
  awaitActive readers charterCid
  awaitArchived (coreParties parties) proposalCid
  forA_ readers $ \reader -> do
    Some charter <- queryContractId reader charterCid
    charter === charterFor terms
  pure charterCid

-- Onboarding and intent contracts, each core signer's view read on its own participant.
data MpOnboarding = MpOnboarding with
  proposals : [[(ContractId SecurePoolProposal, SecurePoolProposal)]]
  charters : [[(ContractId SecurePoolCharter, SecurePoolCharter)]]
  factoryProposals : [(ContractId SecureSwapIntentFactoryProposal, SecureSwapIntentFactoryProposal)]
  factories : [(ContractId SecureSwapIntentFactory, SecureSwapIntentFactory)]
  intents : [(ContractId SecureSwapIntent, SecureSwapIntent)]
  executionApprovals : [(ContractId SecureSwapIntentExecutionApproval, SecureSwapIntentExecutionApproval)]
    deriving (Eq, Show)

sortedById : [(ContractId t, t)] -> [(ContractId t, t)]
sortedById = sortOn (show . fst)

onboardingOf : MpParties -> Script MpOnboarding
onboardingOf parties = do
  proposals <- mapA (\reader -> sortedById <$> query @SecurePoolProposal reader) (coreParties parties)
  charters <- mapA (\reader -> sortedById <$> query @SecurePoolCharter reader) (coreParties parties)
  factoryProposals <- sortedById <$> query @SecureSwapIntentFactoryProposal parties.operator
  factories <- sortedById <$> query @SecureSwapIntentFactory parties.operator
  intents <- sortedById <$> query @SecureSwapIntent parties.operator
  executionApprovals <- sortedById <$> query @SecureSwapIntentExecutionApproval parties.operator
  pure MpOnboarding with proposals; charters; factoryProposals; factories; intents; executionApprovals

-- `rejectsWith`, also requiring every onboarding and intent contract to be unchanged.
mpRejects : MpParties -> SecureMarket -> (Either SubmitError a -> Script ()) -> Script (Either SubmitError a) -> Script ()
mpRejects parties market check submission = do
  before <- onboardingOf parties
  rejectsWith market check submission
  onboardingOf parties >>= (=== before)

-- A Treasury-for-stablecoin swap submitted from the trader's participant with the pool
-- disclosed by the custodian's participant, checked on every participant that sees it.
mpSwap : SecureMarket -> ContractId SecurePool -> ContractId Holding -> Int -> Int -> Script SecureSwapResult
mpSwap market poolCid inputCid inputAtoms expectedOut = do
  let trader = market.fixture.trader
  (pool, treasuryReserve, stableReserve) <- checkSecurePool market poolCid
  totals <- totalsOf market
  treasuryHeld <- holdingAtoms trader market.lineage.treasuryInstrument
  stableHeld <- holdingAtoms trader market.lineage.stableInstrument
  disclosures <- secureDisclosures market poolCid
  deadline <- futureDeadline
  result <- submit (actAs trader <> discloseMany disclosures) $
    swapCommand poolCid trader TreasuryForStable inputCid inputAtoms expectedOut deadline pool.stateVersion
  awaitActive (poolReaders market) result.poolCid
  awaitActive [trader] result.outputHoldingCid
  result.amountOut === amountOf expectedOut
  (next, nextTreasury, nextStable) <- checkSecurePool market result.poolCid
  (atomsOf nextTreasury.amount, atomsOf nextStable.amount)
    === (atomsOf treasuryReserve.amount + inputAtoms, atomsOf stableReserve.amount - expectedOut)
  (atomsOf next.treasuryFeeAmount, next.stableFeeAmount)
    === (atomsOf pool.treasuryFeeAmount + feeFor inputAtoms, pool.stableFeeAmount)
  (next.stateVersion, next.totalShares) === (pool.stateVersion + 1, pool.totalShares)
  assertArchived trader inputCid
  holdingAtoms trader market.lineage.treasuryInstrument >>= (=== treasuryHeld - inputAtoms)
  holdingAtoms trader market.lineage.stableInstrument >>= (=== stableHeld + expectedOut)
  totalsOf market >>= (=== totals)
  pure result

-- A deposit of at most 500,000 Treasury and 1,000,000 stablecoin atoms from the provider's
-- participant; it must mint exactly `expectedMint` for exactly the stated contribution.
mpAdd : SecureMarket -> ContractId SecurePool -> ContractId Holding -> ContractId Holding -> Int -> Int -> Int -> Script SecureAddLiquidityResult
mpAdd market poolCid treasuryCid stableCid expectedMint expectedTreasury expectedStable = do
  let provider = market.fixture.provider
  (pool, treasuryReserve, stableReserve) <- checkSecurePool market poolCid
  totals <- totalsOf market
  disclosures <- secureDisclosures market poolCid
  result <- submit (actAs provider <> discloseMany disclosures) $ exerciseCmd poolCid AddLiquidity with
    provider
    treasuryHoldingCid = treasuryCid
    stableHoldingCid = stableCid
    maximumTreasury = amountOf 500000
    maximumStable = amountOf 1000000
    minimumShares = amountOf expectedMint
    expectedVersion = pool.stateVersion
  awaitActive (poolReaders market) result.poolCid
  awaitActive [provider] result.positionCid
  (result.mintedShares, result.usedTreasury, result.usedStable)
    === (amountOf expectedMint, amountOf expectedTreasury, amountOf expectedStable)
  (next, nextTreasury, nextStable) <- checkSecurePool market result.poolCid
  (atomsOf nextTreasury.amount, atomsOf nextStable.amount)
    === (atomsOf treasuryReserve.amount + expectedTreasury, atomsOf stableReserve.amount + expectedStable)
  atomsOf next.totalShares === atomsOf pool.totalShares + expectedMint
  (next.treasuryFeeAmount, next.stableFeeAmount, next.stateVersion)
    === (pool.treasuryFeeAmount, pool.stableFeeAmount, pool.stateVersion + 1)
  Some position <- queryContractId provider result.positionCid
  (position.provider, atomsOf position.shares, position.genesisCid) === (provider, expectedMint, market.charterCid)
  totalsOf market >>= (=== totals)
  pure result

-- A withdrawal from the provider's participant that must pay exactly the stated amounts.
mpRemove : SecureMarket -> ContractId SecurePool -> ContractId SecureLiquidityPosition -> Int -> Int -> Int -> Script SecureRemoveLiquidityResult
mpRemove market poolCid positionCid burnAtoms expectedTreasury expectedStable = do
  let provider = market.fixture.provider
  (pool, treasuryReserve, stableReserve) <- checkSecurePool market poolCid
  Some position <- queryContractId provider positionCid
  totals <- totalsOf market
  treasuryHeld <- holdingAtoms provider market.lineage.treasuryInstrument
  stableHeld <- holdingAtoms provider market.lineage.stableInstrument
  disclosures <- secureDisclosures market poolCid
  result <- submit (actAs provider <> discloseMany disclosures) $ exerciseCmd poolCid RemoveLiquidity with
    provider
    positionCid
    burnShares = amountOf burnAtoms
    minimumTreasuryOut = amountOf expectedTreasury
    minimumStableOut = amountOf expectedStable
    expectedVersion = pool.stateVersion
  awaitActive (poolReaders market) result.poolCid
  (result.treasuryOut, result.stableOut) === (amountOf expectedTreasury, amountOf expectedStable)
  (next, nextTreasury, nextStable) <- checkSecurePool market result.poolCid
  (atomsOf nextTreasury.amount, atomsOf nextStable.amount)
    === (atomsOf treasuryReserve.amount - expectedTreasury, atomsOf stableReserve.amount - expectedStable)
  atomsOf next.totalShares === atomsOf pool.totalShares - burnAtoms
  (next.treasuryFeeAmount, next.stableFeeAmount, next.stateVersion)
    === (pool.treasuryFeeAmount, pool.stableFeeAmount, pool.stateVersion + 1)
  Some remainingCid <- pure result.remainingPositionCid
  awaitActive [provider] remainingCid
  Some remaining <- queryContractId provider remainingCid
  atomsOf remaining.shares === atomsOf position.shares - burnAtoms
  assertArchived provider positionCid
  holdingAtoms provider market.lineage.treasuryInstrument >>= (=== treasuryHeld + expectedTreasury)
  holdingAtoms provider market.lineage.stableInstrument >>= (=== stableHeld + expectedStable)
  totalsOf market >>= (=== totals)
  pure result

-- A stablecoin-for-Treasury intent: governance approves the execution on its participant and
-- the operator executes it on its own, with the trader's holding disclosed by the trader.
mpExecuteIntent : SecureMarket -> ContractId SecurePool -> ContractId SecureSwapIntent -> ContractId Holding -> Int -> Int -> Script SecureSwapResult
mpExecuteIntent market poolCid intentCid inputCid inputAtoms expectedOut = do
  let fixture = market.fixture
  (pool, treasuryReserve, stableReserve) <- checkSecurePool market poolCid
  totals <- totalsOf market
  treasuryHeld <- holdingAtoms fixture.trader market.lineage.treasuryInstrument
  stableHeld <- holdingAtoms fixture.trader market.lineage.stableInstrument
  approvalCid <- submit fixture.governance $ createCmd SecureSwapIntentExecutionApproval with
    operator = fixture.operator
    governance = fixture.governance
    intentCid
    inputHoldingCid = inputCid
  awaitActive [fixture.operator] approvalCid
  inputDisclosed <- disclosureOf fixture.trader inputCid
  result <- submit (actAs fixture.operator <> discloseMany [inputDisclosed]) $ exerciseCmd approvalCid ExecuteApprovedIntent
  awaitActive (poolReaders market) result.poolCid
  awaitArchived [fixture.operator, fixture.governance] approvalCid
  awaitActive [fixture.trader] result.outputHoldingCid
  awaitArchived [fixture.trader, fixture.auditor] intentCid
  result.amountOut === amountOf expectedOut
  (next, nextTreasury, nextStable) <- checkSecurePool market result.poolCid
  (atomsOf nextStable.amount, atomsOf nextTreasury.amount)
    === (atomsOf stableReserve.amount + inputAtoms, atomsOf treasuryReserve.amount - expectedOut)
  (atomsOf next.stableFeeAmount, next.treasuryFeeAmount)
    === (atomsOf pool.stableFeeAmount + feeFor inputAtoms, pool.treasuryFeeAmount)
  Some output <- queryContractId fixture.trader result.outputHoldingCid
  (output.owner, output.instrument, atomsOf output.amount) === (fixture.trader, market.lineage.treasuryInstrument, expectedOut)
  holdingAtoms fixture.trader market.lineage.stableInstrument >>= (=== stableHeld - inputAtoms)
  holdingAtoms fixture.trader market.lineage.treasuryInstrument >>= (=== treasuryHeld + expectedOut)
  holdingAtoms fixture.operator market.lineage.treasuryInstrument >>= (=== 0)
  holdingAtoms fixture.governance market.lineage.treasuryInstrument >>= (=== 0)
  totalsOf market >>= (=== totals)
  pure result

-- PHASE 1. Allocates each role's party on its own participant.
mpAllocate : () -> Script MpParties
mpAllocate () = do
  let on hint participant = allocatePartyOn hint (ParticipantName participant)
  custodian <- on "MpCustodian" "custodian"
  operator <- on "MpOperator" "operator"
  governance <- on "MpGovernance" "governance"
  treasuryIssuer <- on "MpTreasuryIssuer" "treasury_issuer"
  stableIssuer <- on "MpStableIssuer" "stable_issuer"
  trader <- on "MpTrader" "trader"
  provider <- on "MpProvider" "provider"
  auditor <- on "MpAuditor" "auditor"
  pure MpParties with custodian; operator; governance; treasuryIssuer; stableIssuer; trader; provider; auditor

-- PHASE 2. Every participant knows all eight parties and hosts exactly its own role's party.
mpVerifyHosting : MpParties -> Script ()
mpVerifyHosting parties = do
  let everyone = allParties parties
  assertMsg "Every role is a distinct party" (unique everyone)
  forA_ (hostingPlan parties) $ \(participant, party) -> do
    poll ("parties known on " <> participant) 240 $ do
      known <- listKnownPartiesOn (ParticipantName participant)
      pure (all (`elem` map (\details -> details.party) known) everyone)
    known <- listKnownPartiesOn (ParticipantName participant)
    [details.party | details <- known, details.isLocal, details.party `elem` everyone] === [party]
    debug ("HOSTING " <> participant <> " hosts " <> show party <> " and no other AMM role")

-- PHASE 3. The core signers try to create a charter in one submission, as the IDE tests do.
-- Expected to fail: no participant hosts all four.
mpSingleSubmissionCharter : MpParties -> Script ()
mpSingleSubmissionCharter parties = do
  let lineage = SecureLineage with
        custodian = parties.custodian
        operator = parties.operator
        governance = parties.governance
        treasuryInstrument = InstrumentId with issuer = parties.treasuryIssuer; symbol = "UST"
        stableInstrument = InstrumentId with issuer = parties.stableIssuer; symbol = "USD"
        charterReference = "single-submission"
  _ <- submit (actAs (coreSignatories lineage)) $ createCmd SecurePoolCharter with
    lineage
    initialProvider = parties.provider
    auditors = []
  abort "A charter needing four participants' parties was created in one submission"

-- PHASE 4. Scenarios 1 to 10, each submitted from the participants of the roles involved.
mpScenarios : MpParties -> Script MpState
mpScenarios parties = do
  let treasuryInstrument = InstrumentId with issuer = parties.treasuryIssuer; symbol = "UST"
  let stableInstrument = InstrumentId with issuer = parties.stableIssuer; symbol = "USD"
  treasuryInstrumentCid <- submit parties.treasuryIssuer $ createCmd TokenInstrument with
    instrument = treasuryInstrument
    displayName = "Tokenized U.S. Treasury"
    auditors = [parties.auditor]
  stableInstrumentCid <- submit parties.stableIssuer $ createCmd TokenInstrument with
    instrument = stableInstrument
    displayName = "USD Stablecoin"
    auditors = [parties.auditor]
  let lineage = SecureLineage with
        custodian = parties.custodian
        operator = parties.operator
        governance = parties.governance
        treasuryInstrument
        stableInstrument
        charterReference = "multi-participant-pool"

  -- SCENARIO 1. Onboarding and initialization: the operator proposes the charter terms; the
  -- Treasury issuer, the stablecoin issuer and the custodian each approve on their own
  -- participant; the operator finalizes; the provider initializes on its participant.
  terms <- termsFor parties lineage "multi-participant-pool"
  proposal0 <- mpPropose parties terms
  proposal1 <- mpApprove parties parties.treasuryIssuer terms proposal0
  proposal2 <- mpApprove parties parties.stableIssuer terms proposal1
  proposal3 <- mpApprove parties parties.custodian terms proposal2
  charterCid <- mpFinalize parties terms proposal3
  initialTreasury <- issueFrom parties.treasuryIssuer treasuryInstrumentCid parties.auditor parties.provider 5000000
  initialStable <- issueFrom parties.stableIssuer stableInstrumentCid parties.auditor parties.provider 10000000
  initialized <- submit parties.provider $ exerciseCmd charterCid InitializePool with
    treasuryHoldingCid = initialTreasury
    stableHoldingCid = initialStable
    treasuryAmount = amountOf 5000000
    stableAmount = amountOf 10000000
  let state0 = MpState with
        parties; lineage; treasuryInstrumentCid; stableInstrumentCid; charterCid; initialized
        poolCid = initialized.poolCid
  let market = marketOf state0
  awaitActive (poolReaders market) initialized.poolCid
  awaitActive [parties.provider] initialized.positionCid
  awaitArchived (poolReaders market) charterCid
  (pool0, _, _) <- checkSecurePool market initialized.poolCid
  (atomsOf pool0.totalShares, pool0.stateVersion) === (7071067, 0)
  Some position0 <- queryContractId parties.provider initialized.positionCid
  atomsOf position0.shares === 7071066
  totalsOf market >>= (=== Totals with treasury = 5000000; stable = 10000000)
  debug "SCENARIO 1 initialization: PASS"

  -- SCENARIO 2. Swap on the trader's participant; the four core participants confirm.
  swapInput <- issue market treasuryInstrument parties.trader 1000
  swapped <- mpSwap market initialized.poolCid swapInput 1000 1993
  debug "SCENARIO 2 swap: PASS"

  -- SCENARIO 3. Deposit on the provider's participant.
  depositTreasury <- issue market treasuryInstrument parties.provider 500000
  depositStable <- issue market stableInstrument parties.provider 1000000
  added <- mpAdd market swapped.poolCid depositTreasury depositStable 706965 500000 999601
  debug "SCENARIO 3 deposit: PASS"

  -- SCENARIO 4. Withdrawal of half the deposit's shares.
  removed <- mpRemove market added.poolCid added.positionCid 353482 249999 499799
  debug "SCENARIO 4 withdrawal: PASS"

  -- SCENARIO 5. Swap intent: the operator and governance create the factory on their own
  -- participants, the trader submits on its own, and the execution needs both controllers.
  let factoryTerms = SecureFactoryTerms with
        lineage
        genesisCid = charterCid
        authorizedTraders = [parties.trader]
        complianceObservers = [parties.auditor]
  factoryProposal <- submit parties.operator $ createCmd SecureSwapIntentFactoryProposal with terms = factoryTerms
  awaitActive [parties.governance] factoryProposal
  factoryCid <- submit parties.governance $ exerciseCmd factoryProposal AcceptFactoryProposal with expectedTerms = factoryTerms
  awaitActive [parties.trader, parties.operator, parties.auditor] factoryCid
  awaitArchived [parties.operator, parties.governance] factoryProposal
  Some factory <- queryContractId parties.operator factoryCid
  factory === SecureSwapIntentFactory with
    lineage
    genesisCid = charterCid
    authorizedTraders = [parties.trader]
    complianceObservers = [parties.auditor]
  deadline <- futureDeadline
  Some poolBeforeIntent <- queryContractId parties.custodian removed.poolCid
  intentCid <- submit parties.trader $ exerciseCmd factoryCid SubmitSwapIntent with
    trader = parties.trader
    poolCid = removed.poolCid
    direction = StableForTreasury
    inputAmount = amountOf 2000
    minimumAmountOut = amountOf 997
    deadline
    expectedPoolVersion = poolBeforeIntent.stateVersion
  awaitActive [parties.operator, parties.governance, parties.auditor] intentCid
  intentInput <- issue market stableInstrument parties.trader 5000
  rejectsWith market assertAuthorizationError $ do
    inputDisclosed <- disclosureOf parties.trader intentInput
    trySubmit (actAs parties.operator <> discloseMany [inputDisclosed]) $
      exerciseCmd intentCid Execute with inputHoldingCid = intentInput
  executed <- mpExecuteIntent market removed.poolCid intentCid intentInput 2000 997
  Some changeCid <- pure executed.inputChangeHoldingCid
  awaitActive [parties.trader] changeCid
  Some change <- queryContractId parties.trader changeCid
  (change.owner, atomsOf change.amount) === (parties.trader, 3000)
  debug "SCENARIO 5 swap intent execution: PASS"

  let current = executed.poolCid
  (pool, _, _) <- checkSecurePool market current
  disclosures <- secureDisclosures market current
  victimInput <- issue market treasuryInstrument parties.trader 1000
  victimDisclosed <- disclosureOf parties.trader victimInput
  Some providerPositionCid <- pure removed.remainingPositionCid
  positionDisclosed <- disclosureOf parties.provider providerPositionCid
  attackDeadline <- futureDeadline

  -- SCENARIO 6. Operator-only diversion on the operator's participant, with every contract it
  -- does not already see disclosed.
  let asOperator = actAs parties.operator <> discloseMany (victimDisclosed :: positionDisclosed :: disclosures)
  forA_ [pool.treasuryReserveCid, pool.stableReserveCid] $ \reserveCid ->
    rejectsWith market assertAuthorizationError $ trySubmit asOperator $ archiveCmd reserveCid
  rejectsWith market assertAuthorizationError $ trySubmit asOperator $ archiveCmd current
  rejectsWith market assertAuthorizationError $ trySubmit asOperator $
    swapCommand current parties.trader TreasuryForStable victimInput 1000 0 attackDeadline pool.stateVersion
  rejectsWith market assertAuthorizationError $ trySubmit asOperator $ exerciseCmd current RemoveLiquidity with
    provider = parties.provider
    positionCid = providerPositionCid
    burnShares = amountOf 1000
    minimumTreasuryOut = 0.0
    minimumStableOut = 0.0
    expectedVersion = pool.stateVersion
  rejectsWith market assertAuthorizationError $ trySubmit parties.operator $ createCmd Holding with
    instrument = treasuryInstrument
    owner = parties.operator
    amount = pool.treasuryReserveAmount
    auditors = []
  debug "SCENARIO 6 operator-only diversion rejected: PASS"

  -- SCENARIO 7. Issuer-only archival, each issuer on its own participant.
  forA_ [(parties.treasuryIssuer, pool.treasuryReserveCid), (parties.stableIssuer, pool.stableReserveCid)] $ \(issuer, reserveCid) -> do
    let asIssuer = actAs issuer <> discloseMany (positionDisclosed :: disclosures)
    rejectsWith market assertAuthorizationError $ trySubmit asIssuer $ archiveCmd reserveCid
    rejectsWith market assertAuthorizationError $ trySubmit asIssuer $ archiveCmd current
    rejectsWith market assertAuthorizationError $ trySubmit asIssuer $ archiveCmd providerPositionCid
  debug "SCENARIO 7 issuer-only archival rejected: PASS"

  -- SCENARIO 8. Operator and governance collusion across their two participants: governance
  -- signs an unrestricted proxy that the operator exercises.
  proxyCid <- submit parties.governance $ createCmd GovernanceProxy with
    operator = parties.operator
    governance = parties.governance
  awaitActive [parties.operator] proxyCid
  Some providerPosition <- queryContractId parties.provider providerPositionCid
  let asColluder = actAs parties.operator <> discloseMany (victimDisclosed :: disclosures)
  forA_ [pool.treasuryReserveCid, pool.stableReserveCid] $ \reserveCid ->
    rejectsWith market assertAuthorizationError $ trySubmit asColluder $
      exerciseCmd proxyCid ProxyArchiveReserve with reserveCid
  rejectsWith market assertAuthorizationError $ trySubmit asColluder $
    exerciseCmd proxyCid ProxyArchivePool with poolCid = current
  rejectsWith market assertAuthorizationError $ trySubmit asColluder $
    exerciseCmd proxyCid ProxyCreatePool with pool
  rejectsWith market assertAuthorizationError $ trySubmit asColluder $
    exerciseCmd proxyCid ProxyMintPosition with position = providerPosition with provider = parties.operator
  rejectsWith market assertAuthorizationError $ trySubmit asColluder $
    exerciseCmd proxyCid ProxySwapAsTrader with
      poolCid = current
      trader = parties.trader
      inputHoldingCid = victimInput
      inputAmount = amountOf 1000
      deadline = attackDeadline
      expectedVersion = pool.stateVersion
  debug "SCENARIO 8 operator and governance collusion rejected: PASS"

  -- SCENARIO 9. Disclosure and visibility, read on each role's own participant.
  let poolContracts reader = do
        pools <- query @SecurePool reader
        reserves <- query @SecureReserveHolding reader
        positions <- query @SecureLiquidityPosition reader
        pure (length pools, length reserves, length positions)
  forA_ (poolReaders market) (poolContracts >=> (=== (1, 2, 2)))
  poolContracts parties.trader >>= (=== (0, 0, 0))
  poolContracts parties.provider >>= (=== (0, 0, 2))
  forA_ [parties.operator, parties.custodian, parties.governance, parties.provider] $ \reader -> do
    seen <- queryContractId reader victimInput
    assertMsg ("The trader's holding is visible to " <> show reader) (isNone seen)
  auditorView <- queryContractId parties.auditor victimInput
  assertMsg "The holding auditor does not see the trader's holding" (isSome auditorView)
  rejectsWith market (assertInvisibleActive market [show current]) $ trySubmit parties.trader $
    swapCommand current parties.trader TreasuryForStable victimInput 1000 0 attackDeadline pool.stateVersion
  debug "SCENARIO 9 disclosure and visibility: PASS"

  -- SCENARIO 10. Replay of consumed contracts.
  rejectsWith market (Settlement.assertConsumedAmong [show swapInput]) $
    trySubmit (actAs parties.trader <> discloseMany disclosures) $
      swapCommand current parties.trader TreasuryForStable swapInput 1000 0 attackDeadline pool.stateVersion
  replayApproval <- submit parties.governance $ createCmd SecureSwapIntentExecutionApproval with
    operator = parties.operator
    governance = parties.governance
    intentCid
    inputHoldingCid = victimInput
  awaitActive [parties.operator] replayApproval
  rejectsWith market (Settlement.assertConsumedAmong [show intentCid]) $
    trySubmit (actAs parties.operator <> discloseMany [victimDisclosed]) $ exerciseCmd replayApproval ExecuteApprovedIntent
  replayTreasury <- issue market treasuryInstrument parties.provider 5000000
  replayStable <- issue market stableInstrument parties.provider 10000000
  rejectsWith market (Settlement.assertConsumedAmong [show charterCid]) $
    trySubmit parties.provider $ exerciseCmd charterCid InitializePool with
      treasuryHoldingCid = replayTreasury
      stableHoldingCid = replayStable
      treasuryAmount = amountOf 5000000
      stableAmount = amountOf 10000000
  debug "SCENARIO 10 replay rejection: PASS"

  pure state0 with poolCid = current

-- PHASE 5. Run with a participant config that routes the core signers and the Treasury issuer
-- to the trader's participant, which hosts none of them: it must refuse both submissions.
mpImpersonation : MpState -> Script [Text]
mpImpersonation state = do
  forgedReserve <- trySubmit (actAs (coreSignatories state.lineage)) $ createCmd SecureReserveHolding with
    lineage = state.lineage
    genesisCid = state.charterCid
    instrument = state.lineage.treasuryInstrument
    amount = amountOf 1000000
    auditors = []
  forgedHolding <- trySubmit state.parties.treasuryIssuer $ createCmd Holding with
    instrument = state.lineage.treasuryInstrument
    owner = state.parties.trader
    amount = amountOf 1000000
    auditors = []
  let outcome label result = case result of
        Left err@UnknownError {unknownErrorMessage}
          | "NO_SYNCHRONIZER_ON_WHICH_ALL_SUBMITTERS_CAN_SUBMIT" `isInfixOf` unknownErrorMessage ->
            pure (label <> " rejected: " <> show err)
        Left err -> abort (label <> " failed for another reason: " <> show err)
        Right _ -> abort (label <> " was accepted by a participant that does not host its submitters")
  reserveOutcome <- outcome "IMPERSONATION core-signed reserve from the trader participant" forgedReserve
  holdingOutcome <- outcome "IMPERSONATION issuer-signed holding from the trader participant" forgedHolding
  forA_ [reserveOutcome, holdingOutcome] debug
  pure [reserveOutcome, holdingOutcome]

-- PHASE 6. After PHASE 5: onboarding attacks, each submitted from the participant of the party
-- attempting it, with every onboarding, pool and holding contract unchanged after each one. A
-- second pool is then onboarded on the same instruments and stays isolated from the first. Ends
-- with a proposal every core signer has approved, for the outage phases.
mpOnboardingAttacks : MpState -> Script MpOutage
mpOnboardingAttacks state = do
  let parties = state.parties
  let market = marketOf state
  terms <- termsFor parties state.lineage "multi-participant-second-pool"
  let approveCmd approver expectedTerms proposalCid =
        exerciseCmd proposalCid ApprovePoolProposal with approver; expectedTerms

  mpRejects parties market assertAuthorizationError $ trySubmit parties.operator $ createCmd (charterFor terms)
  mpRejects parties market assertAuthorizationError $ trySubmit parties.custodian $ createCmd (charterFor terms)
  mpRejects parties market assertAuthorizationError $ trySubmit parties.governance $
    createCmd SecurePoolProposal with terms; approvals = [parties.operator]
  mpRejects parties market assertAuthorizationError $ trySubmit parties.operator $
    createCmd SecurePoolProposal with terms; approvals = [parties.operator, parties.treasuryIssuer]
  debug "ONBOARDING unauthorized charter creation and forged approval rejected: PASS"

  proposal0 <- mpPropose parties terms
  disclosed0 <- disclosureOf parties.operator proposal0
  let asGovernance = actAs parties.governance <> discloseMany [disclosed0]
  mpRejects parties market assertAuthorizationError $ trySubmit parties.operator $ approveCmd parties.treasuryIssuer terms proposal0
  mpRejects parties market assertAuthorizationError $ trySubmit parties.operator $ approveCmd parties.stableIssuer terms proposal0
  mpRejects parties market assertAuthorizationError $ trySubmit asGovernance $ approveCmd parties.custodian terms proposal0
  mpRejects parties market (assertFailureId onboardingApproverError) $ trySubmit asGovernance $ approveCmd parties.governance terms proposal0
  mpRejects parties market assertAuthorizationError $ trySubmit parties.custodian $
    exerciseCmd proposal0 FinalizePoolProposal with expectedTerms = terms
  debug "ONBOARDING operator acting for an issuer and governance acting for the custodian rejected: PASS"

  let wrongTerms =
        [ terms with initialProvider = parties.trader
        , terms with auditors = []
        , terms with lineage = (terms.lineage with stableInstrument = (terms.lineage.stableInstrument with symbol = "USDX"))
        , terms with lineage = (terms.lineage with treasuryInstrument = (terms.lineage.treasuryInstrument with issuer = parties.stableIssuer))
        , terms with lineage = (terms.lineage with governance = parties.auditor)
        , terms with lineage = (terms.lineage with operator = parties.governance)
        , terms with lineage = (terms.lineage with charterReference = "multi-participant-pool")
        ]
  forA_ wrongTerms $ \wrong ->
    mpRejects parties market (assertFailureId onboardingTermsError) $ trySubmit parties.treasuryIssuer $
      approveCmd parties.treasuryIssuer wrong proposal0
  debug "ONBOARDING approval of different parameters rejected: PASS"

  proposal1 <- mpApprove parties parties.treasuryIssuer terms proposal0
  mpRejects parties market (Settlement.assertConsumedAmong [show proposal0]) $ trySubmit parties.treasuryIssuer $
    approveCmd parties.treasuryIssuer terms proposal0
  mpRejects parties market (Settlement.assertConsumedAmong [show proposal0]) $ trySubmit parties.stableIssuer $
    approveCmd parties.stableIssuer terms proposal0
  mpRejects parties market (assertFailureId onboardingApproverError) $ trySubmit parties.treasuryIssuer $
    approveCmd parties.treasuryIssuer terms proposal1
  proposal2 <- mpApprove parties parties.custodian terms proposal1
  mpRejects parties market (assertFailureId onboardingIncompleteError) $ trySubmit parties.operator $
    exerciseCmd proposal2 FinalizePoolProposal with expectedTerms = terms
  debug "ONBOARDING replayed approval and finalization without the stablecoin issuer rejected: PASS"

  missingTerms <- termsFor parties state.lineage "multi-participant-missing-custodian"
  missing <- mpPropose parties missingTerms
    >>= mpApprove parties parties.treasuryIssuer missingTerms
    >>= mpApprove parties parties.stableIssuer missingTerms
  mpRejects parties market (assertFailureId onboardingIncompleteError) $ trySubmit parties.operator $
    exerciseCmd missing FinalizePoolProposal with expectedTerms = missingTerms
  debug "ONBOARDING finalization without the custodian rejected: PASS"

  let conflictingTerms = missingTerms with initialProvider = parties.trader
  conflicting <- mpPropose parties conflictingTerms
  mpRejects parties market (assertFailureId onboardingTermsError) $ trySubmit parties.custodian $
    approveCmd parties.custodian missingTerms conflicting
  mpRejects parties market (assertFailureId onboardingTermsError) $ trySubmit parties.operator $
    exerciseCmd missing FinalizePoolProposal with expectedTerms = conflictingTerms
  submit parties.custodian $ exerciseCmd conflicting CancelPoolProposal with canceller = parties.custodian
  awaitArchived (coreParties parties) conflicting
  submit parties.stableIssuer $ exerciseCmd missing CancelPoolProposal with canceller = parties.stableIssuer
  awaitArchived (coreParties parties) missing
  mpRejects parties market (Settlement.assertConsumedAmong [show conflicting]) $ trySubmit parties.custodian $
    approveCmd parties.custodian conflictingTerms conflicting
  mpRejects parties market (Settlement.assertConsumedAmong [show missing]) $ trySubmit parties.custodian $
    approveCmd parties.custodian missingTerms missing
  mpRejects parties market (Settlement.assertConsumedAmong [show missing]) $ trySubmit parties.operator $
    exerciseCmd missing FinalizePoolProposal with expectedTerms = missingTerms
  debug "ONBOARDING conflicting approval and resubmitted cancelled proposals rejected: PASS"

  proposal3 <- mpApprove parties parties.stableIssuer terms proposal2
  secondCharter <- mpFinalize parties terms proposal3
  mpRejects parties market (Settlement.assertConsumedAmong [show proposal3]) $ trySubmit parties.operator $
    exerciseCmd proposal3 FinalizePoolProposal with expectedTerms = terms
  mpRejects parties market (Settlement.assertConsumedAmong [show proposal3]) $ trySubmit parties.custodian $
    exerciseCmd proposal3 CancelPoolProposal with canceller = parties.custodian
  debug "ONBOARDING stale finalized proposal and double finalization rejected: PASS"

  secondTreasury <- issueFrom parties.treasuryIssuer state.treasuryInstrumentCid parties.auditor parties.provider 5000000
  secondStable <- issueFrom parties.stableIssuer state.stableInstrumentCid parties.auditor parties.provider 10000000
  secondInitialized <- submit parties.provider $ exerciseCmd secondCharter InitializePool with
    treasuryHoldingCid = secondTreasury
    stableHoldingCid = secondStable
    treasuryAmount = amountOf 5000000
    stableAmount = amountOf 10000000
  let second = market with lineage = terms.lineage; charterCid = secondCharter; initialized = secondInitialized
  awaitActive (poolReaders second) secondInitialized.poolCid
  awaitActive [parties.provider] secondInitialized.positionCid
  (secondPool, _, _) <- checkSecurePool second secondInitialized.poolCid
  firstBefore <- checkSecurePool market state.poolCid

  secondDisclosures <- secureDisclosures second secondInitialized.poolCid
  positions <- query @SecureLiquidityPosition parties.provider
  (firstPositionCid, _) :: _ <- pure
    [entry | entry@(_, position) <- positions, position.genesisCid == state.charterCid, position.provider == parties.provider]
  mpRejects parties market (assertFailureId positionError) $ trySubmit (actAs parties.provider <> discloseMany secondDisclosures) $
    exerciseCmd secondInitialized.poolCid RemoveLiquidity with
      provider = parties.provider
      positionCid = firstPositionCid
      burnShares = amountOf 1000
      minimumTreasuryOut = 0.0
      minimumStableOut = 0.0
      expectedVersion = secondPool.stateVersion

  [(factoryCid, _)] <- query @SecureSwapIntentFactory parties.operator
  deadline <- futureDeadline
  crossIntent <- submit parties.trader $ exerciseCmd factoryCid SubmitSwapIntent with
    trader = parties.trader
    poolCid = secondInitialized.poolCid
    direction = StableForTreasury
    inputAmount = amountOf 2000
    minimumAmountOut = 0.0
    deadline
    expectedPoolVersion = secondPool.stateVersion
  awaitActive [parties.operator, parties.governance] crossIntent
  crossInput <- issue market state.lineage.stableInstrument parties.trader 5000
  crossApproval <- submit parties.governance $ createCmd SecureSwapIntentExecutionApproval with
    operator = parties.operator
    governance = parties.governance
    intentCid = crossIntent
    inputHoldingCid = crossInput
  awaitActive [parties.operator] crossApproval
  crossDisclosed <- disclosureOf parties.trader crossInput
  mpRejects parties market (assertFailureId poolMismatchError) $ trySubmit (actAs parties.operator <> discloseMany [crossDisclosed]) $
    exerciseCmd crossApproval ExecuteApprovedIntent
  submit parties.governance $ exerciseCmd crossApproval CancelExecutionApproval with canceller = parties.governance
  submit parties.trader $ exerciseCmd crossIntent Cancel
  awaitArchived [parties.operator, parties.governance] crossApproval
  awaitArchived [parties.operator, parties.governance] crossIntent

  secondInput <- issue market state.lineage.treasuryInstrument parties.trader 1000
  _ <- mpSwap second secondInitialized.poolCid secondInput 1000 1993
  checkSecurePool market state.poolCid >>= (=== firstBefore)
  debug "ONBOARDING second pool isolated from the first pool's position and intents: PASS"

  outageTerms <- termsFor parties state.lineage "multi-participant-outage"
  outageCid <- mpPropose parties outageTerms
    >>= mpApprove parties parties.treasuryIssuer outageTerms
    >>= mpApprove parties parties.stableIssuer outageTerms
    >>= mpApprove parties parties.custodian outageTerms
  pure MpOutage with state; terms = outageTerms; proposalCid = outageCid

-- PHASE 7. With the stablecoin issuer's participant disconnected, a swap and the finalization of
-- the fully approved proposal are attempted. Neither may commit, and nothing may change.
mpOfflineSwap : MpOutage -> Script MpLiveness
mpOfflineSwap outage = do
  let state = outage.state
  let market = marketOf state
  let parties = state.parties
  reserves <- query @SecureReserveHolding parties.custodian
  length [() | (_, reserve) <- reserves, reserve.genesisCid == state.charterCid] === 2
  forgedHoldings <- query @Holding parties.treasuryIssuer
  [() | (_, holding) <- forgedHoldings, atomsOf holding.amount == 1000000, holding.owner == parties.trader] === []
  (pool, treasuryReserve, stableReserve) <- checkSecurePool market state.poolCid
  inputCid <- issue market state.lineage.treasuryInstrument parties.trader 1000
  disclosures <- secureDisclosures market state.poolCid
  deadline <- futureDeadline
  let timedOut label result = case result of
        Left err@UnknownError {unknownErrorMessage}
          | "MEDIATOR_SAYS_TX_TIMED_OUT" `isInfixOf` unknownErrorMessage ->
            debug ("LIVENESS " <> label <> " with the stablecoin issuer's participant disconnected rejected: " <> show err)
        Left err -> abort ("The offline " <> label <> " failed for another reason: " <> show err)
        Right _ -> abort ("A " <> label <> " committed while the stablecoin issuer's participant was disconnected")
  swapResult <- trySubmit (actAs parties.trader <> discloseMany disclosures) $
    swapCommand state.poolCid parties.trader TreasuryForStable inputCid 1000 0 deadline pool.stateVersion
  timedOut "swap" swapResult
  forA_ [parties.custodian, parties.operator, parties.governance, parties.treasuryIssuer, parties.auditor] $ \reader -> do
    Some seen <- queryContractId reader state.poolCid
    seen === pool
  Some currentTreasury <- queryContractId parties.custodian pool.treasuryReserveCid
  Some currentStable <- queryContractId parties.custodian pool.stableReserveCid
  (currentTreasury, currentStable) === (treasuryReserve, stableReserve)
  inputStill <- queryContractId parties.trader inputCid
  assertMsg "The trader's input was consumed by a swap that did not commit" (isSome inputStill)

  finalizeResult <- trySubmit parties.operator $
    exerciseCmd outage.proposalCid FinalizePoolProposal with expectedTerms = outage.terms
  timedOut "finalization" finalizeResult
  forA_ [parties.custodian, parties.operator, parties.treasuryIssuer] $ \reader -> do
    proposal <- queryContractId reader outage.proposalCid
    assertMsg "The approved proposal was consumed by a finalization that did not commit" (isSome proposal)
    charters <- query @SecurePoolCharter reader
    [() | (_, charter) <- charters, charter.lineage == outage.terms.lineage] === []
  pure MpLiveness with outage; inputCid

-- PHASE 8. After reconnecting the stablecoin issuer's participant, the same swap settles and the
-- same proposal finalizes into exactly its charter.
mpReconnectedSwap : MpLiveness -> Script MpState
mpReconnectedSwap liveness = do
  let outage = liveness.outage
  let market = marketOf outage.state
  swapped <- mpSwap market outage.state.poolCid liveness.inputCid 1000 1993
  debug "LIVENESS swap after reconnecting the stablecoin issuer's participant: PASS"
  _ <- mpFinalize outage.state.parties outage.terms outage.proposalCid
  debug "LIVENESS finalization after reconnecting the stablecoin issuer's participant: PASS"
  pure outage.state with poolCid = swapped.poolCid

-- The paused pool after PHASE 9, the provider's position still to be redeemed in full, and a
-- resume proposal every core signer has approved for exactly that paused state.
data MpPaused = MpPaused with
  state : MpState
  pausedPoolCid : ContractId SecurePausedPool
  depositPositionCid : ContractId SecureLiquidityPosition
  resumeTerms : SecureResumeTerms
  resumeProposalCid : ContractId SecureResumeProposal
    deriving (Eq, Show)

-- One core signer approves a pause or resume on its own participant; the successor carries the
-- same terms and exactly the previous signatures plus the approver's.
mpApprovePause : MpParties -> Party -> SecurePauseTerms -> ContractId SecurePauseProposal -> Script (ContractId SecurePauseProposal)
mpApprovePause parties approver terms proposalCid = do
  Some proposal <- queryContractId approver proposalCid
  nextCid <- submit approver $ exerciseCmd proposalCid ApprovePause with approver; expectedTerms = terms
  awaitActive (coreParties parties) nextCid
  awaitArchived (coreParties parties) proposalCid
  Some next <- queryContractId parties.operator nextCid
  next === SecurePauseProposal with terms; approvals = proposal.approvals ++ [approver]
  pure nextCid

mpApproveResume : MpParties -> Party -> SecureResumeTerms -> ContractId SecureResumeProposal -> Script (ContractId SecureResumeProposal)
mpApproveResume parties approver terms proposalCid = do
  Some proposal <- queryContractId approver proposalCid
  nextCid <- submit approver $ exerciseCmd proposalCid ApproveResume with approver; expectedTerms = terms
  awaitActive (coreParties parties) nextCid
  awaitArchived (coreParties parties) proposalCid
  Some next <- queryContractId parties.operator nextCid
  next === SecureResumeProposal with terms; approvals = proposal.approvals ++ [approver]
  pure nextCid

-- The operator proposes on its participant; the Treasury issuer, the stablecoin issuer and the
-- custodian each approve on their own.
mpCollectResume : MpParties -> SecureResumeTerms -> Script (ContractId SecureResumeProposal)
mpCollectResume parties terms = do
  proposalCid <- submit parties.operator $ createCmd SecureResumeProposal with terms; approvals = [parties.operator]
  awaitActive (coreParties parties) proposalCid
  mpApproveResume parties parties.treasuryIssuer terms proposalCid
    >>= mpApproveResume parties parties.stableIssuer terms
    >>= mpApproveResume parties parties.custodian terms

-- A paused-pool withdrawal from the provider's participant, checked on every participant that
-- sees the paused state: exact payouts, successor version, supply, unchanged fee counters and
-- totals, and the position remainder.
mpPausedRemove : SecureMarket -> ContractId SecurePausedPool -> ContractId SecureLiquidityPosition -> Int -> Int -> Int -> Script SecurePausedRemoveLiquidityResult
mpPausedRemove market pausedPoolCid positionCid burnAtoms expectedTreasury expectedStable = do
  let provider = market.fixture.provider
  (pool, treasuryReserve, stableReserve) <- checkPausedPool market pausedPoolCid
  Some position <- queryContractId provider positionCid
  totals <- totalsOf market
  treasuryHeld <- holdingAtoms provider market.lineage.treasuryInstrument
  stableHeld <- holdingAtoms provider market.lineage.stableInstrument
  disclosures <- pausedDisclosures market pausedPoolCid
  result <- submit (actAs provider <> discloseMany disclosures) $ exerciseCmd pausedPoolCid RemovePausedLiquidity with
    provider
    positionCid
    burnShares = amountOf burnAtoms
    minimumTreasuryOut = amountOf expectedTreasury
    minimumStableOut = amountOf expectedStable
    expectedVersion = pool.stateVersion
  awaitActive (poolReaders market) result.poolCid
  awaitArchived (poolReaders market) pausedPoolCid
  (result.treasuryOut, result.stableOut) === (amountOf expectedTreasury, amountOf expectedStable)
  (next, nextTreasury, nextStable) <- checkPausedPool market result.poolCid
  (atomsOf nextTreasury.amount, atomsOf nextStable.amount)
    === (atomsOf treasuryReserve.amount - expectedTreasury, atomsOf stableReserve.amount - expectedStable)
  atomsOf next.totalShares === atomsOf pool.totalShares - burnAtoms
  (next.treasuryFeeAmount, next.stableFeeAmount, next.stateVersion)
    === (pool.treasuryFeeAmount, pool.stableFeeAmount, pool.stateVersion + 1)
  case result.remainingPositionCid of
    Some remainingCid -> do
      awaitActive [provider] remainingCid
      Some remaining <- queryContractId provider remainingCid
      atomsOf remaining.shares === atomsOf position.shares - burnAtoms
    None -> atomsOf position.shares === burnAtoms
  assertArchived provider positionCid
  holdingAtoms provider market.lineage.treasuryInstrument >>= (=== treasuryHeld + expectedTreasury)
  holdingAtoms provider market.lineage.stableInstrument >>= (=== stableHeld + expectedStable)
  totalsOf market >>= (=== totals)
  pure result

-- PHASE 9. Pause, each core signer approving on its own participant. Wrong approvals first: the
-- operator approving in the Treasury issuer's name, governance approving, an approval of other
-- terms, finalization with three approvals; then the four independent approvals, a replayed and
-- a repeated approval, and the pause. While paused: swaps and a deposit on the consumed active
-- state and on the paused state as a `SecurePool` reference are rejected, and the provider's
-- partial withdrawal settles. Ends with a fully approved resume of the current paused state.
mpPauseLifecycle : MpState -> Script MpPaused
mpPauseLifecycle state = do
  let parties = state.parties
  let market = marketOf state
  (pool, _, _) <- checkSecurePool market state.poolCid
  (atomsOf pool.treasuryReserveAmount, atomsOf pool.stableReserveAmount, atomsOf pool.totalShares)
    === (5251004, 10497816, 7424550)
  activeDisclosures <- secureDisclosures market state.poolCid
  expiresAt <- futureDeadline
  let terms = pauseTermsFor market state.poolCid pool.stateVersion expiresAt
  let approveCmd approver expectedTerms proposalCid =
        exerciseCmd proposalCid ApprovePause with approver; expectedTerms
  proposal0 <- submit parties.operator $ createCmd SecurePauseProposal with terms; approvals = [parties.operator]
  awaitActive (coreParties parties) proposal0
  disclosed0 <- disclosureOf parties.operator proposal0
  mpRejects parties market assertAuthorizationError $ trySubmit parties.operator $
    approveCmd parties.treasuryIssuer terms proposal0
  mpRejects parties market (assertFailureId lifecycleApproverError) $
    trySubmit (actAs parties.governance <> discloseMany [disclosed0]) $ approveCmd parties.governance terms proposal0
  mpRejects parties market (assertFailureId lifecycleTermsError) $ trySubmit parties.custodian $
    approveCmd parties.custodian (terms with expectedVersion = pool.stateVersion - 1) proposal0
  mpRejects parties market assertAuthorizationError $ trySubmit parties.governance $
    createCmd SecurePauseProposal with terms; approvals = coreParties parties
  proposal1 <- mpApprovePause parties parties.treasuryIssuer terms proposal0
  proposal2 <- mpApprovePause parties parties.stableIssuer terms proposal1
  mpRejects parties market (assertFailureId lifecycleIncompleteError) $ trySubmit parties.operator $
    exerciseCmd proposal2 FinalizePause with finalizer = parties.operator; expectedTerms = terms
  mpRejects parties market (Settlement.assertConsumedAmong [show proposal1]) $ trySubmit parties.stableIssuer $
    approveCmd parties.stableIssuer terms proposal1
  mpRejects parties market (assertFailureId lifecycleApproverError) $ trySubmit parties.stableIssuer $
    approveCmd parties.stableIssuer terms proposal2
  debug "PAUSE wrong, impersonated, replayed and incomplete approvals rejected: PASS"

  proposal3 <- mpApprovePause parties parties.custodian terms proposal2
  pausedCid <- submit parties.operator $ exerciseCmd proposal3 FinalizePause with finalizer = parties.operator; expectedTerms = terms
  awaitActive (poolReaders market) pausedCid
  awaitArchived (poolReaders market) state.poolCid
  awaitArchived (coreParties parties) proposal3
  forA_ (poolReaders market) $ \reader -> do
    Some seen <- queryContractId reader pausedCid
    seen === pausedStateOf pool
  _ <- checkPausedPool market pausedCid
  mpRejects parties market (Settlement.assertConsumedAmong [show proposal3]) $ trySubmit parties.operator $
    exerciseCmd proposal3 FinalizePause with finalizer = parties.operator; expectedTerms = terms
  debug "PAUSE independent approvals from four participants and finalization: PASS"

  pausedDisclosed <- pausedDisclosures market pausedCid
  let asActive = coerceContractId @SecurePausedPool @SecurePool pausedCid
  deadline <- futureDeadline
  swapInput <- issue market state.lineage.treasuryInstrument parties.trader 1000
  depositTreasury <- issue market state.lineage.treasuryInstrument parties.provider 500000
  depositStable <- issue market state.lineage.stableInstrument parties.provider 1000000
  mpRejects parties market (Settlement.assertConsumedAmong [show state.poolCid]) $
    trySubmit (actAs parties.trader <> discloseMany activeDisclosures) $
      swapCommand state.poolCid parties.trader TreasuryForStable swapInput 1000 0 deadline pool.stateVersion
  mpRejects parties market Prototype.assertWronglyTyped $
    trySubmit (actAs parties.trader <> discloseMany pausedDisclosed) $
      swapCommand asActive parties.trader TreasuryForStable swapInput 1000 0 deadline (pool.stateVersion + 1)
  debug "PAUSE trading blocked: PASS"
  let addCmd target version = exerciseCmd target AddLiquidity with
        provider = parties.provider
        treasuryHoldingCid = depositTreasury
        stableHoldingCid = depositStable
        maximumTreasury = amountOf 500000
        maximumStable = amountOf 1000000
        minimumShares = 0.0
        expectedVersion = version
  mpRejects parties market (Settlement.assertConsumedAmong [show state.poolCid]) $
    trySubmit (actAs parties.provider <> discloseMany activeDisclosures) $ addCmd state.poolCid pool.stateVersion
  mpRejects parties market Prototype.assertWronglyTyped $
    trySubmit (actAs parties.provider <> discloseMany pausedDisclosed) $ addCmd asActive (pool.stateVersion + 1)
  debug "PAUSE deposits blocked: PASS"

  partial <- mpPausedRemove market pausedCid state.initialized.positionCid 1000000 707248 1413932
  positions <- query @SecureLiquidityPosition parties.provider
  [depositPositionCid] <- pure
    [ cid | (cid, position) <- positions
    , position.genesisCid == state.charterCid
    , Some cid /= partial.remainingPositionCid ]
  Some depositPosition <- queryContractId parties.provider depositPositionCid
  atomsOf depositPosition.shares === 353483
  debug "PAUSE provider's partial withdrawal while paused: PASS"

  (paused, _, _) <- checkPausedPool market partial.poolCid
  let resumeTerms = resumeTermsFor market partial.poolCid paused.stateVersion expiresAt
  resumeProposalCid <- mpCollectResume parties resumeTerms
  pure MpPaused with state; pausedPoolCid = partial.poolCid; depositPositionCid; resumeTerms; resumeProposalCid

-- PHASE 10. With the stablecoin issuer's participant disconnected, the provider's full withdrawal
-- and the finalization of the fully approved resume are attempted. Every payout re-signs the
-- reserves, which needs the stablecoin issuer's confirmation, so neither may commit: an offline
-- core signer blocks LP exits from a paused pool exactly as it blocks trading. Nothing changes.
mpOfflinePausedExit : MpPaused -> Script MpPaused
mpOfflinePausedExit pausedState = do
  let state = pausedState.state
  let market = marketOf state
  let parties = state.parties
  (paused, treasuryReserve, stableReserve) <- checkPausedPool market pausedState.pausedPoolCid
  disclosures <- pausedDisclosures market pausedState.pausedPoolCid
  let timedOut label result = case result of
        Left err@UnknownError {unknownErrorMessage}
          | "MEDIATOR_SAYS_TX_TIMED_OUT" `isInfixOf` unknownErrorMessage ->
            debug ("LIVENESS paused " <> label <> " with the stablecoin issuer's participant disconnected rejected: " <> show err)
        Left err -> abort ("The offline paused " <> label <> " failed for another reason: " <> show err)
        Right _ -> abort ("A paused " <> label <> " committed while the stablecoin issuer's participant was disconnected")
  exitResult <- trySubmit (actAs parties.provider <> discloseMany disclosures) $
    exerciseCmd pausedState.pausedPoolCid RemovePausedLiquidity with
      provider = parties.provider
      positionCid = pausedState.depositPositionCid
      burnShares = amountOf 353483
      minimumTreasuryOut = 0.0
      minimumStableOut = 0.0
      expectedVersion = paused.stateVersion
  timedOut "LP withdrawal" exitResult
  resumeResult <- trySubmit parties.operator $ exerciseCmd pausedState.resumeProposalCid FinalizeResume with
    finalizer = parties.operator
    expectedTerms = pausedState.resumeTerms
  timedOut "resume" resumeResult
  forA_ [parties.custodian, parties.operator, parties.governance, parties.treasuryIssuer, parties.auditor] $ \reader -> do
    Some seen <- queryContractId reader pausedState.pausedPoolCid
    seen === paused
    pools <- query @SecurePool reader
    [() | (_, pool) <- pools, pool.genesisCid == state.charterCid] === []
  Some currentTreasury <- queryContractId parties.custodian paused.treasuryReserveCid
  Some currentStable <- queryContractId parties.custodian paused.stableReserveCid
  (currentTreasury, currentStable) === (treasuryReserve, stableReserve)
  position <- queryContractId parties.provider pausedState.depositPositionCid
  assertMsg "The provider's position was consumed by a withdrawal that did not commit" (isSome position)
  proposal <- queryContractId parties.operator pausedState.resumeProposalCid
  assertMsg "The resume proposal was consumed by a resume that did not commit" (isSome proposal)
  pure pausedState

-- PHASE 11. After reconnecting: the same full withdrawal settles; the resume approved for the
-- replaced paused state is rejected as consumed; a fresh four-participant resume restores the
-- pool with every field carried over; replayed and governance approvals are rejected; a swap
-- settles on the resumed pool and the pre-pause state stays unusable.
mpResumeAfterOutage : MpPaused -> Script ()
mpResumeAfterOutage pausedState = do
  let state = pausedState.state
  let market = marketOf state
  let parties = state.parties
  exit <- mpPausedRemove market pausedState.pausedPoolCid pausedState.depositPositionCid 353483 250000 499801
  exit.remainingPositionCid === None
  debug "LIVENESS paused LP withdrawal after reconnecting the stablecoin issuer's participant: PASS"
  (paused, _, _) <- checkPausedPool market exit.poolCid
  (atomsOf paused.treasuryReserveAmount, atomsOf paused.stableReserveAmount, atomsOf paused.totalShares)
    === (4293756, 8584083, 6071067)
  mpRejects parties market (Settlement.assertConsumedAmong [show pausedState.pausedPoolCid]) $ trySubmit parties.operator $
    exerciseCmd pausedState.resumeProposalCid FinalizeResume with finalizer = parties.operator; expectedTerms = pausedState.resumeTerms
  submit parties.custodian $ exerciseCmd pausedState.resumeProposalCid CancelResume with canceller = parties.custodian
  awaitArchived (coreParties parties) pausedState.resumeProposalCid
  debug "PAUSE resume approved for a replaced paused state rejected: PASS"

  expiresAt <- futureDeadline
  let terms = resumeTermsFor market exit.poolCid paused.stateVersion expiresAt
  proposalCid <- mpCollectResume parties terms
  disclosed <- disclosureOf parties.operator proposalCid
  mpRejects parties market (assertFailureId lifecycleApproverError) $
    trySubmit (actAs parties.governance <> discloseMany [disclosed]) $
      exerciseCmd proposalCid ApproveResume with approver = parties.governance; expectedTerms = terms
  mpRejects parties market (assertFailureId lifecycleApproverError) $ trySubmit parties.custodian $
    exerciseCmd proposalCid ApproveResume with approver = parties.custodian; expectedTerms = terms
  resumedCid <- submit parties.operator $ exerciseCmd proposalCid FinalizeResume with finalizer = parties.operator; expectedTerms = terms
  awaitActive (poolReaders market) resumedCid
  awaitArchived (poolReaders market) exit.poolCid
  forA_ (poolReaders market) $ \reader -> do
    Some seen <- queryContractId reader resumedCid
    seen === activeStateOf paused
  _ <- checkSecurePool market resumedCid
  mpRejects parties market (Settlement.assertConsumedAmong [show proposalCid]) $ trySubmit parties.operator $
    exerciseCmd proposalCid FinalizeResume with finalizer = parties.operator; expectedTerms = terms
  debug "PAUSE resume from four participants, replayed and governance approvals rejected: PASS"

  inputCid <- issue market state.lineage.treasuryInstrument parties.trader 1000
  traded <- mpSwap market resumedCid inputCid 1000 1992
  (next, _, _) <- checkSecurePool market traded.poolCid
  (atomsOf next.treasuryReserveAmount, atomsOf next.stableReserveAmount, atomsOf next.totalShares)
    === (4294756, 8582091, 6071067)
  staleDisclosures <- secureDisclosures market traded.poolCid
  staleInput <- issue market state.lineage.treasuryInstrument parties.trader 1000
  deadline <- futureDeadline
  mpRejects parties market (assertFailureId staleStateError) $
    trySubmit (actAs parties.trader <> discloseMany staleDisclosures) $
      swapCommand traded.poolCid parties.trader TreasuryForStable staleInput 1000 0 deadline paused.stateVersion
  debug "PAUSE swap after resume settles and the pre-resume version is rejected: PASS"

-- Legacy has no onboarding workflow and `PoolSetup` needs the operator and governance, which no
-- single participant hosts here. In the migration rehearsal the operator proposes the setup and
-- governance accepts on its own participant: a test-only setup step, not a production workflow.
template LegacyPoolSetupProposal
  with
    poolId : PoolId
    initialProvider : Party
    auditors : [Party]
  where
    signatory poolId.operator
    observer poolId.governance

    choice AcceptLegacyPoolSetup : ContractId Legacy.PoolSetup
      controller poolId.governance
      do create Legacy.PoolSetup with poolId; initialProvider; auditors

data MpMigration = MpMigration with
  state : MpState
  secondProvider : Party
    deriving (Eq, Show)

-- PHASE 12. Allocates an independent second LP on its own ninth participant, `second_provider`,
-- and checks from every participant that it is known everywhere and hosted only there.
mpMigrationAllocate : MpState -> Script MpMigration
mpMigrationAllocate state = do
  secondProvider <- allocatePartyOn "MpSecondProvider" (ParticipantName "second_provider")
  let everyone = secondProvider :: allParties state.parties
  let participants = "second_provider" :: map fst (hostingPlan state.parties)
  forA_ participants $ \participant ->
    poll ("parties known on " <> participant) 240 $ do
      known <- listKnownPartiesOn (ParticipantName participant)
      pure (all (`elem` map (\details -> details.party) known) everyone)
  forA_ participants $ \participant -> do
    known <- listKnownPartiesOn (ParticipantName participant)
    let local = [details.party | details <- known, details.isLocal, details.party `elem` everyone]
    if participant == "second_provider"
      then local === [secondProvider]
      else assertMsg ("Second provider hosted on " <> participant) (secondProvider `notElem` local)
  debug ("MIGRATION second_provider hosts " <> show secondProvider <> " and no other AMM role")
  pure MpMigration with state; secondProvider

-- Waits until the operator, governance and the auditor see the legacy state and each issuer sees
-- its reserve, then takes the rehearsal procedure's snapshot.
mpLegacySnapshot : MpParties -> MigrationReaders -> PoolId -> ContractId Legacy.Pool -> Script LegacySnapshot
mpLegacySnapshot parties readers poolId poolCid = do
  awaitActive [parties.operator, parties.governance, parties.auditor] poolCid
  Some pool <- queryContractId parties.operator poolCid
  awaitActive [parties.treasuryIssuer, parties.auditor] pool.treasuryReserveHoldingCid
  awaitActive [parties.stableIssuer, parties.auditor] pool.stableReserveHoldingCid
  snapshot <- requireLegacySnapshot readers poolId
  snapshot.poolCid === poolCid
  pure snapshot

-- One LP's whole legacy exit from its own participant, with the operator's participant
-- disclosing the state, checked by the rehearsal procedure once every reader has applied it.
mpLegacyExit : MpParties -> MigrationReaders -> LegacySnapshot -> Party -> Script (Legacy.RemoveLiquidityResult, LegacySnapshot)
mpLegacyExit parties readers snapshot provider = do
  let claim = claimOf snapshot provider
  result <- submitLegacyExit parties.operator snapshot claim
  _ <- mpLegacySnapshot parties readers snapshot.pool.poolId result.poolCid
  forA_ [result.treasuryOutputHoldingCid, result.stableOutputHoldingCid] $ \payoutCid ->
    awaitActive [provider, parties.auditor] (fromSome payoutCid)
  awaitArchived [provider, parties.auditor] claim.positionCid
  next <- checkLegacyExit readers snapshot claim result
  pure (result, next)

-- A legacy swap from the trader's participant, disclosed by the operator's.
mpLegacySwap : MpParties -> MigrationReaders -> LegacySnapshot -> SwapDirection -> ContractId Holding -> Int -> Int -> Script LegacySnapshot
mpLegacySwap parties readers snapshot direction inputCid inputAtoms expectedOut = do
  disclosures <- legacyDisclosures parties.operator snapshot
  deadline <- futureDeadline
  result <- submit (actAs parties.trader <> discloseMany disclosures) $ exerciseCmd snapshot.poolCid Legacy.SwapExactInput with
    trader = parties.trader
    direction
    inputHoldingCid = inputCid
    inputAmount = amountOf inputAtoms
    minimumAmountOut = amountOf expectedOut
    deadline
    expectedVersion = snapshot.pool.stateVersion
  atomsOf result.amountOut === expectedOut
  awaitActive [parties.trader] result.outputHoldingCid
  mpLegacySnapshot parties readers snapshot.pool.poolId result.poolCid

migrationTotals : SecureLineage -> Script Totals
migrationTotals lineage = do
  treasury <- instrumentUnits lineage.treasuryInstrument
  stable <- instrumentUnits lineage.stableInstrument
  pure Totals with treasury; stable

-- PHASE 13. The voluntary migration of `Migration:fullMigration` on the nine participants, with
-- the same amounts. Synthetic balances are issued first, from the issuers' participants, and the
-- instrument totals must not change after that. The legacy pool is set up through
-- `LegacyPoolSetupProposal`; the provider initializes it, the second LP deposits and the trader
-- swaps in both directions, each from its own participant. The rehearsal procedure then reads the
-- legacy pool as the auditor and the issuers see it, and each LP exits from its own participant;
-- a replay of the first exit fails on the consumed state. The Secure V1 pool is onboarded through
-- `SecurePoolProposal`, initialized from the first LP's proceeds and joined with the second LP's;
-- one swap and one withdrawal settle; the completion check reports no blocker.
mpMigrationRehearsal : MpMigration -> Script ()
mpMigrationRehearsal migration = do
  let state = migration.state
  let parties = state.parties
  let second = migration.secondProvider
  let treasury = state.lineage.treasuryInstrument
  let stable = state.lineage.stableInstrument
  let readers = MigrationReaders with
        auditor = parties.auditor
        treasuryIssuer = parties.treasuryIssuer
        stableIssuer = parties.stableIssuer
  let issueTreasuryTo = issueFrom parties.treasuryIssuer state.treasuryInstrumentCid parties.auditor
  let issueStableTo = issueFrom parties.stableIssuer state.stableInstrumentCid parties.auditor
  providerTreasury <- issueTreasuryTo parties.provider 5000000
  providerStable <- issueStableTo parties.provider 10000000
  secondTreasury <- issueTreasuryTo second 500000
  secondStable <- issueStableTo second 1000000
  legacyTreasuryInput <- issueTreasuryTo parties.trader 10000
  legacyStableInput <- issueStableTo parties.trader 5000
  secureInput <- issueTreasuryTo parties.trader 1000
  totals <- migrationTotals state.lineage

  let poolId = PoolId with
        operator = parties.operator
        governance = parties.governance
        treasuryInstrument = treasury
        stableInstrument = stable
        setupReference = "mp-migration"
  setupProposalCid <- submit parties.operator $ createCmd LegacyPoolSetupProposal with
    poolId
    initialProvider = parties.provider
    auditors = [parties.auditor]
  awaitActive [parties.governance] setupProposalCid
  setupCid <- submit parties.governance $ exerciseCmd setupProposalCid AcceptLegacyPoolSetup
  awaitActive [parties.provider] setupCid
  initialized <- submit parties.provider $ exerciseCmd setupCid Legacy.Initialize with
    treasuryHoldingCid = providerTreasury
    stableHoldingCid = providerStable
    treasuryAmount = amountOf 5000000
    stableAmount = amountOf 10000000
  initial <- mpLegacySnapshot parties readers poolId initialized.poolCid
  initialDisclosed <- legacyDisclosures parties.operator initial
  added <- submit (actAs second <> discloseMany initialDisclosed) $ exerciseCmd initial.poolCid Legacy.AddLiquidity with
    provider = second
    treasuryHoldingCid = secondTreasury
    stableHoldingCid = secondStable
    maximumTreasury = amountOf 500000
    maximumStable = amountOf 1000000
    minimumShares = amountOf 707106
    expectedVersion = initial.pool.stateVersion
  atomsOf added.mintedShares === 707106
  deposited <- mpLegacySnapshot parties readers poolId added.poolCid
  swappedOnce <- mpLegacySwap parties readers deposited TreasuryForStable legacyTreasuryInput 10000 19903
  opening <- mpLegacySwap parties readers swappedOnce StableForTreasury legacyStableInput 5000 2500
  ( atomsOf opening.pool.treasuryReserveAmount, atomsOf opening.pool.stableReserveAmount, atomsOf opening.pool.totalShares
    , atomsOf opening.pool.treasuryFeeAmount, atomsOf opening.pool.stableFeeAmount )
    === (5507500, 10985097, 7778173, 30, 15)
  sortOn show (map (\claim -> (claim.provider, claim.shares, claim.treasuryClaim, claim.stableClaim)) opening.claims)
    === sortOn show [(parties.provider, 7071066, 5006817, 9986451), (second, 707106, 500681, 998644)]
  migrationTotals state.lineage >>= (=== totals)
  debug "MIGRATION legacy pool with two LPs and swaps, snapshot reconciled by the auditor and issuers: PASS"

  openingDisclosed <- legacyDisclosures parties.operator opening
  (first, afterFirst) <- mpLegacyExit parties readers opening parties.provider
  let firstClaim = claimOf opening parties.provider
  Settlement.assertConsumedAmong
      [show opening.poolCid, show firstClaim.positionCid, show opening.pool.treasuryReserveHoldingCid, show opening.pool.stableReserveHoldingCid]
    =<< trySubmit (actAs parties.provider <> discloseMany openingDisclosed) (legacyExitCommand opening firstClaim)
  requireLegacySnapshot readers poolId >>= (=== afterFirst)
  (secondExit, afterSecond) <- mpLegacyExit parties readers afterFirst second
  ((atomsOf first.treasuryOut, atomsOf first.stableOut), (atomsOf secondExit.treasuryOut, atomsOf secondExit.stableOut))
    === ((5006817, 9986451), (500682, 998644))
  (afterSecond.claims, atomsOf afterSecond.pool.totalShares) === ([], 1)
  legacyExitBlockers readers poolId >>= (=== [])
  migrationTotals state.lineage >>= (=== totals)
  debug "MIGRATION both LPs exited the legacy pool from their own participants; replayed exit rejected: PASS"

  let lineage = state.lineage with charterReference = "mp-migration"
  terms <- termsFor parties lineage "mp-migration"
  charterCid <- mpPropose parties terms
    >>= mpApprove parties parties.treasuryIssuer terms
    >>= mpApprove parties parties.custodian terms
    >>= mpApprove parties parties.stableIssuer terms
    >>= mpFinalize parties terms
  secureInitialized <- submit parties.provider $ exerciseCmd charterCid InitializePool with
    treasuryHoldingCid = fromSome first.treasuryOutputHoldingCid
    stableHoldingCid = fromSome first.stableOutputHoldingCid
    treasuryAmount = first.treasuryOut
    stableAmount = first.stableOut
  let market = (marketOf state) with
        secondProvider = second
        lineage
        charterCid
        initialized = secureInitialized
  awaitActive (poolReaders market) secureInitialized.poolCid
  awaitActive [parties.provider] secureInitialized.positionCid
  (pool0, _, _) <- checkSecurePool market secureInitialized.poolCid
  (atomsOf pool0.treasuryReserveAmount, atomsOf pool0.stableReserveAmount, atomsOf pool0.totalShares) === (5006817, 9986451, 7071091)

  disclosed0 <- secureDisclosures market secureInitialized.poolCid
  secondAdded <- submit (actAs second <> discloseMany disclosed0) $ exerciseCmd secureInitialized.poolCid AddLiquidity with
    provider = second
    treasuryHoldingCid = fromSome secondExit.treasuryOutputHoldingCid
    stableHoldingCid = fromSome secondExit.stableOutputHoldingCid
    maximumTreasury = secondExit.treasuryOut
    maximumStable = secondExit.stableOut
    minimumShares = amountOf 707108
    expectedVersion = 0
  (atomsOf secondAdded.mintedShares, atomsOf secondAdded.usedTreasury, atomsOf secondAdded.usedStable) === (707108, 500681, 998644)
  awaitActive (poolReaders market) secondAdded.poolCid
  awaitActive [second] secondAdded.positionCid
  _ <- checkSecurePool market secondAdded.poolCid
  debug "MIGRATION Secure V1 onboarded on four participants and funded from both LPs' legacy proceeds: PASS"

  swapped <- mpSwap market secondAdded.poolCid secureInput 1000 1988
  disclosed1 <- secureDisclosures market swapped.poolCid
  removed <- submit (actAs second <> discloseMany disclosed1) $ exerciseCmd swapped.poolCid RemoveLiquidity with
    provider = second
    positionCid = secondAdded.positionCid
    burnShares = amountOf 353554
    minimumTreasuryOut = amountOf 250385
    minimumStableOut = amountOf 499231
    expectedVersion = 2
  (atomsOf removed.treasuryOut, atomsOf removed.stableOut) === (250385, 499231)
  awaitActive (poolReaders market) removed.poolCid
  awaitActive [second] (fromSome removed.remainingPositionCid)
  let expected = SecureExpectation with
        treasuryReserve = 5258113
        stableReserve = 10483876
        totalShares = 7424645
        positions = [(parties.provider, 7071090), (second, 353554)]
        totals
  migrationCompletionBlockers readers poolId lineage charterCid expected >>= (=== [])
  migrationCompletionBlockers readers poolId lineage charterCid (expected with totalShares = 7424646)
    >>= (=== ["secure LP supply: expected 7424646, found 7424645"])
  debug "MIGRATION swap and withdrawal on the new pool; completion reconciled, a wrong expectation refused: PASS"
