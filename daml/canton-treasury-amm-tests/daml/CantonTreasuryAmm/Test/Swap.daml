module CantonTreasuryAmm.Test.Swap where

import DA.Assert ((===))
import Daml.Script

import CantonTreasuryAmm.Errors
import CantonTreasuryAmm.LiquidityPosition
import CantonTreasuryAmm.Pool
import CantonTreasuryAmm.Test.Fixtures
import CantonTreasuryAmm.Types

reserveProduct : Pool -> Wide
reserveProduct pool =
  wide (atomsOf pool.treasuryReserveAmount) * wide (atomsOf pool.stableReserveAmount)

treasuryForStableUsesExactInputPricing : Script ()
treasuryForStableUsesExactInputPricing = do
  Initialized {fixture, initialized} <- standardPool
  inputHoldingCid <- issueTreasury fixture fixture.trader (amountOf 1000)
  result <- submitDirectSwap fixture initialized.poolCid fixture.trader TreasuryForStable
    inputHoldingCid (amountOf 1000) 0.0
  atomsOf result.amountOut === 1993
  Some output <- queryContractId fixture.trader result.outputHoldingCid
  output.instrument === fixture.stableInstrument
  atomsOf output.amount === 1993
  pool <- assertActivePool fixture result.poolCid
  atomsOf pool.treasuryReserveAmount === 5001000
  atomsOf pool.stableReserveAmount === 9998007
  atomsOf pool.treasuryFeeAmount === 3
  atomsOf pool.stableFeeAmount === 0
  assertPoolReservesMatch fixture result.poolCid

stableForTreasuryIsSymmetric : Script ()
stableForTreasuryIsSymmetric = do
  Initialized {fixture, initialized} <- standardPool
  inputHoldingCid <- issueStable fixture fixture.trader (amountOf 1000)
  result <- submitDirectSwap fixture initialized.poolCid fixture.trader StableForTreasury
    inputHoldingCid (amountOf 1000) 0.0
  atomsOf result.amountOut === 498
  Some output <- queryContractId fixture.trader result.outputHoldingCid
  output.instrument === fixture.treasuryInstrument
  atomsOf output.amount === 498
  pool <- assertActivePool fixture result.poolCid
  atomsOf pool.treasuryReserveAmount === 4999502
  atomsOf pool.stableReserveAmount === 10001000
  atomsOf pool.stableFeeAmount === 3
  atomsOf pool.treasuryFeeAmount === 0
  assertPoolReservesMatch fixture result.poolCid

feesAccumulateInBothAssetsAndRawKGrows : Script ()
feesAccumulateInBothAssetsAndRawKGrows = do
  Initialized {fixture, initialized} <- standardPool
  treasuryInputCid <- issueTreasury fixture fixture.trader (amountOf 1000)
  first <- submitDirectSwap fixture initialized.poolCid fixture.trader TreasuryForStable
    treasuryInputCid (amountOf 1000) 0.0
  stableInputCid <- issueStable fixture fixture.trader (amountOf 2000)
  second <- submitDirectSwap fixture first.poolCid fixture.trader StableForTreasury
    stableInputCid (amountOf 2000) 0.0
  pool <- assertActivePool fixture second.poolCid
  atomsOf pool.treasuryFeeAmount === 3
  atomsOf pool.stableFeeAmount === 6
  assert (reserveProduct pool > wide 5000000 * wide 10000000)

reportingFeesSaturateWithoutBlockingSwaps : Script ()
reportingFeesSaturateWithoutBlockingSwaps = do
  Initialized {fixture, initialized} <- standardPool
  pool <- assertActivePool fixture initialized.poolCid
  nearCapPoolCid <- submit (actAs [fixture.operator, fixture.governance]) $ createCmd pool with
    treasuryFeeAmount = amountOf (maxReserveAtoms - 1)
    stableFeeAmount = amountOf (maxReserveAtoms - 1)

  firstInputCid <- issueTreasury fixture fixture.trader (amountOf 1000)
  first <- submitDirectSwap fixture nearCapPoolCid fixture.trader TreasuryForStable
    firstInputCid (amountOf 1000) 0.0
  atomsOf first.amountOut === 1993
  saturated <- assertActivePool fixture first.poolCid
  atomsOf saturated.treasuryFeeAmount === maxReserveAtoms
  atomsOf saturated.stableFeeAmount === maxReserveAtoms - 1
  assert (reserveProduct saturated > reserveProduct pool)
  assertPoolReservesMatch fixture first.poolCid

  secondInputCid <- issueTreasury fixture fixture.trader (amountOf 1000)
  second <- submitDirectSwap fixture first.poolCid fixture.trader TreasuryForStable
    secondInputCid (amountOf 1000) 0.0
  assert (atomsOf second.amountOut > 0)
  stillSaturated <- assertActivePool fixture second.poolCid
  atomsOf stillSaturated.treasuryFeeAmount === maxReserveAtoms
  assert (reserveProduct stillSaturated > reserveProduct saturated)
  assertPoolReservesMatch fixture second.poolCid

  stableInputCid <- issueStable fixture fixture.trader (amountOf 1000)
  third <- submitDirectSwap fixture second.poolCid fixture.trader StableForTreasury
    stableInputCid (amountOf 1000) 0.0
  assert (atomsOf third.amountOut > 0)
  bothSaturated <- assertActivePool fixture third.poolCid
  atomsOf bothSaturated.treasuryFeeAmount === maxReserveAtoms
  atomsOf bothSaturated.stableFeeAmount === maxReserveAtoms
  assert (reserveProduct bothSaturated > reserveProduct stillSaturated)
  assertPoolReservesMatch fixture third.poolCid

slippageFailureLeavesAllInputsAndPoolUnchanged : Script ()
slippageFailureLeavesAllInputsAndPoolUnchanged = do
  Initialized {fixture, initialized} <- standardPool
  inputHoldingCid <- issueTreasury fixture fixture.trader (amountOf 1000)
  disclosures <- poolDisclosures fixture initialized.poolCid
  deadline <- futureDeadline
  before <- assertActivePool fixture initialized.poolCid
  result <- trySubmit (actAs fixture.trader <> discloseMany disclosures) $
    exerciseCmd initialized.poolCid SwapExactInput with
      trader = fixture.trader
      direction = TreasuryForStable
      inputHoldingCid
      inputAmount = amountOf 1000
      minimumAmountOut = amountOf 1994
      deadline
      expectedVersion = before.stateVersion
  assertFailureId slippageError result
  after <- assertActivePool fixture initialized.poolCid
  after === before
  Some inputAfter <- queryContractId fixture.trader inputHoldingCid
  atomsOf inputAfter.amount === 1000
  positions <- query @LiquidityPosition fixture.provider
  map fst positions === [initialized.positionCid]

zeroOutputSwapRejectsWithoutStateChange : Script ()
zeroOutputSwapRejectsWithoutStateChange = do
  fixture <- setup
  initialized <- initializePool fixture "zero-output" 0.0001 0.0001
  inputHoldingCid <- issueTreasury fixture fixture.trader (amountOf 1)
  disclosures <- poolDisclosures fixture initialized.poolCid
  deadline <- futureDeadline
  before <- assertActivePool fixture initialized.poolCid
  result <- trySubmit (actAs fixture.trader <> discloseMany disclosures) $
    exerciseCmd initialized.poolCid SwapExactInput with
      trader = fixture.trader
      direction = TreasuryForStable
      inputHoldingCid
      inputAmount = amountOf 1
      minimumAmountOut = 0.0
      deadline
      expectedVersion = before.stateVersion
  assertFailureId insufficientLiquidityError result
  after <- assertActivePool fixture initialized.poolCid
  after === before
  Some _ <- queryContractId fixture.trader inputHoldingCid
  pure ()

-- A successful swap consumes the predecessor Pool. Version 0 is then wrong for the active
-- successor, a domain failure (`amm/stale-state`), yet correct for the consumed predecessor,
-- whose exercise is a contract-lifecycle failure (`ContractNotFound` naming that CID). The two
-- must never be reported as the same category.
-- Actor: an ordinary trader. Required authority: the trader alone; the predecessor is reached
-- through a diagnostic `readAs operator` lookup and through a stale explicit disclosure.
-- Verified outcome: the lookup fails naming the predecessor Pool CID. The stale disclosure fails
-- naming the predecessor's consumed reserve, as the IDE ledger does not check the activeness of
-- disclosed contracts. Neither failure consumes the trader's input or changes the successor,
-- which stays active at version 1 with reconciled reserves and then settles a correct swap.
-- Limitation: lifecycle errors are asserted through the public `unknownContractIds`, and the
-- stale-disclosure path is IDE-ledger behaviour; a Canton participant may reject it earlier.
staleVersionAndConsumedPoolFailDifferently : Script ()
staleVersionAndConsumedPoolFailDifferently = do
  Initialized {fixture, initialized} <- standardPool
  predecessor <- assertActivePool fixture initialized.poolCid
  predecessorDisclosure <- disclosureOf fixture.operator initialized.poolCid
  firstInputCid <- issueTreasury fixture fixture.trader (amountOf 1000)
  settled <- submitDirectSwap fixture initialized.poolCid fixture.trader TreasuryForStable
    firstInputCid (amountOf 1000) 0.0
  consumed <- queryContractId fixture.operator initialized.poolCid
  consumed === None
  successor <- assertActivePool fixture settled.poolCid
  successor.stateVersion === predecessor.stateVersion + 1

  inputHoldingCid <- issueTreasury fixture fixture.trader (amountOf 1000)
  Some inputBefore <- queryContractId fixture.trader inputHoldingCid
  deadline <- futureDeadline
  let swapAt poolCid = exerciseCmd poolCid SwapExactInput with
        trader = fixture.trader
        direction = TreasuryForStable
        inputHoldingCid
        inputAmount = amountOf 1000
        minimumAmountOut = 0.0
        deadline
        expectedVersion = predecessor.stateVersion

  successorDisclosures <- poolDisclosures fixture settled.poolCid
  staleOnActive <- trySubmit (actAs fixture.trader <> discloseMany successorDisclosures)
    (swapAt settled.poolCid)
  assertFailureId staleStateError staleOnActive

  consumedVisible <- trySubmit (actAs fixture.trader <> readAs fixture.operator)
    (swapAt initialized.poolCid)
  assertConsumedContract initialized.poolCid consumedVisible
  -- The IDE ledger runs a stale disclosure of the archived Pool without an activeness check, so
  -- the failure surfaces at the predecessor's consumed Treasury reserve instead of the Pool.
  consumedDisclosed <- trySubmit (actAs fixture.trader <> discloseMany [predecessorDisclosure])
    (swapAt initialized.poolCid)
  assertConsumedContract predecessor.treasuryReserveHoldingCid consumedDisclosed

  successorAfter <- assertActivePool fixture settled.poolCid
  successorAfter === successor
  atomsOf successorAfter.treasuryReserveAmount === 5001000
  atomsOf successorAfter.stableReserveAmount === 9998007
  assertPoolReservesMatch fixture settled.poolCid
  Some inputAfter <- queryContractId fixture.trader inputHoldingCid
  inputAfter === inputBefore

  next <- submitDirectSwap fixture settled.poolCid fixture.trader TreasuryForStable
    inputHoldingCid (amountOf 1000) 0.0
  assert (atomsOf next.amountOut > 0)
  nextPool <- assertActivePool fixture next.poolCid
  nextPool.stateVersion === successor.stateVersion + 1
  assertPoolReservesMatch fixture next.poolCid
