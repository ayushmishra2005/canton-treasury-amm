module CantonTreasuryAmm.Test.Liquidity where

import DA.Assert ((===))
import Daml.Script

import CantonTreasuryAmm.Errors
import CantonTreasuryAmm.LiquidityPosition
import CantonTreasuryAmm.Pool
import CantonTreasuryAmm.Test.Fixtures
import CantonTreasuryAmm.Token
import CantonTreasuryAmm.Types

subsequentLiquidityUsesBindingLegAndCeiling : Script ()
subsequentLiquidityUsesBindingLegAndCeiling = do
  Initialized {fixture, initialized} <- standardPool
  treasuryHoldingCid <- issueTreasury fixture fixture.provider 0.0001
  stableHoldingCid <- issueStable fixture fixture.provider 0.0001
  result <- submitAddLiquidity fixture initialized.poolCid fixture.provider
    treasuryHoldingCid stableHoldingCid 0.0001 0.0001 0.0
  -- The stablecoin leg binds at 707106 of the 1414213 shares the Treasury leg alone would allow.
  atomsOf result.mintedShares === 707106
  atomsOf result.usedTreasury === 500000
  atomsOf result.usedStable === 1000000
  pool <- assertActivePool fixture result.poolCid
  atomsOf pool.totalShares === 7778173
  atomsOf pool.treasuryReserveAmount === 5500000
  atomsOf pool.stableReserveAmount === 11000000
  assertPoolReservesMatch fixture result.poolCid

partialThenNearTotalRemovalLeavesLockedLiquidity : Script ()
partialThenNearTotalRemovalLeavesLockedLiquidity = do
  Initialized {fixture, initialized} <- standardPool
  Some position <- queryContractId fixture.provider initialized.positionCid
  let providerShareAtoms = atomsOf position.shares
  let firstBurnAtoms = providerShareAtoms / 2
  first <- submitRemoveLiquidity fixture initialized.poolCid fixture.provider initialized.positionCid
    (amountOf firstBurnAtoms) 0.0 0.0
  Some remainingPositionCid <- pure first.remainingPositionCid
  Some remainingPosition <- queryContractId fixture.provider remainingPositionCid
  second <- submitRemoveLiquidity fixture first.poolCid fixture.provider remainingPositionCid
    remainingPosition.shares 0.0 0.0
  second.remainingPositionCid === None
  pool <- assertActivePool fixture second.poolCid
  atomsOf pool.totalShares === lockedSharesAtoms
  assert (atomsOf pool.treasuryReserveAmount > 0)
  assert (atomsOf pool.stableReserveAmount > 0)
  assertPoolReservesMatch fixture second.poolCid

removalFloorsEachAssetAndRetainsDust : Script ()
removalFloorsEachAssetAndRetainsDust = do
  fixture <- setup
  initialized <- initializePool fixture "rounding-pool" 0.0001 0.0004
  result <- submitRemoveLiquidity fixture initialized.poolCid fixture.provider initialized.positionCid
    (amountOf 1) 0.0 0.0
  atomsOf result.treasuryOut === 0
  atomsOf result.stableOut === 2
  result.treasuryOutputHoldingCid === None
  pool <- assertActivePool fixture result.poolCid
  atomsOf pool.treasuryReserveAmount === 1000000
  atomsOf pool.stableReserveAmount === 3999998

zeroMintRejectsAtomically : Script ()
zeroMintRejectsAtomically = do
  Initialized {fixture, initialized} <- standardPool
  treasuryHoldingCid <- issueTreasury fixture fixture.provider (amountOf 1)
  stableHoldingCid <- issueStable fixture fixture.provider (amountOf 1)
  disclosures <- poolDisclosures fixture initialized.poolCid
  before <- assertActivePool fixture initialized.poolCid
  result <- trySubmit (actAs fixture.provider <> discloseMany disclosures) $
    exerciseCmd initialized.poolCid AddLiquidity with
      provider = fixture.provider
      treasuryHoldingCid
      stableHoldingCid
      maximumTreasury = amountOf 1
      maximumStable = amountOf 1
      minimumShares = 0.0
      expectedVersion = before.stateVersion
  assertFailureId insufficientLiquidityError result
  after <- assertActivePool fixture initialized.poolCid
  after === before
  Some _ <- queryContractId fixture.provider treasuryHoldingCid
  Some _ <- queryContractId fixture.provider stableHoldingCid
  pure ()

minimumSharesRejectsUnderMinting : Script ()
minimumSharesRejectsUnderMinting = do
  Initialized {fixture, initialized} <- standardPool
  treasuryHoldingCid <- issueTreasury fixture fixture.provider (amountOf 1000000)
  stableHoldingCid <- issueStable fixture fixture.provider (amountOf 1000000)
  disclosures <- poolDisclosures fixture initialized.poolCid
  before <- assertActivePool fixture initialized.poolCid
  result <- trySubmit (actAs fixture.provider <> discloseMany disclosures) $
    exerciseCmd initialized.poolCid AddLiquidity with
      provider = fixture.provider
      treasuryHoldingCid
      stableHoldingCid
      maximumTreasury = amountOf 1000000
      maximumStable = amountOf 1000000
      minimumShares = amountOf 707107
      expectedVersion = before.stateVersion
  assertFailureId slippageError result
  after <- assertActivePool fixture initialized.poolCid
  after === before
  Some treasuryHolding <- queryContractId fixture.provider treasuryHoldingCid
  Some stableHolding <- queryContractId fixture.provider stableHoldingCid
  atomsOf treasuryHolding.amount === 1000000
  atomsOf stableHolding.amount === 1000000
  assertPoolReservesMatch fixture initialized.poolCid

minimumOutputsRejectUnderPayout : Script ()
minimumOutputsRejectUnderPayout = do
  Initialized {fixture, initialized} <- standardPool
  disclosures <- poolDisclosures fixture initialized.poolCid
  before <- assertActivePool fixture initialized.poolCid
  Some position <- queryContractId fixture.provider initialized.positionCid
  result <- trySubmit (actAs fixture.provider <> discloseMany disclosures) $
    exerciseCmd initialized.poolCid RemoveLiquidity with
      provider = fixture.provider
      positionCid = initialized.positionCid
      burnShares = amountOf 1000
      minimumTreasuryOut = amountOf 708
      minimumStableOut = 0.0
      expectedVersion = before.stateVersion
  assertFailureId slippageError result
  after <- assertActivePool fixture initialized.poolCid
  after === before
  Some positionAfter <- queryContractId fixture.provider initialized.positionCid
  positionAfter === position
  assertPoolReservesMatch fixture initialized.poolCid

burnIntoLockedSharesIsRejected : Script ()
burnIntoLockedSharesIsRejected = do
  Initialized {fixture, initialized} <- standardPool
  disclosures <- poolDisclosures fixture initialized.poolCid
  before <- assertActivePool fixture initialized.poolCid
  Some position <- queryContractId fixture.provider initialized.positionCid
  result <- trySubmit (actAs fixture.provider <> discloseMany disclosures) $
    exerciseCmd initialized.poolCid RemoveLiquidity with
      provider = fixture.provider
      positionCid = initialized.positionCid
      burnShares = amountOf (atomsOf position.shares + 1)
      minimumTreasuryOut = 0.0
      minimumStableOut = 0.0
      expectedVersion = before.stateVersion
  assertFailureId positionError result
  after <- assertActivePool fixture initialized.poolCid
  after === before
  Some positionAfter <- queryContractId fixture.provider initialized.positionCid
  positionAfter === position
  assertPoolReservesMatch fixture initialized.poolCid

liquidityOperationsRequireExplicitDisclosure : Script ()
liquidityOperationsRequireExplicitDisclosure = do
  Initialized {fixture, initialized} <- standardPool
  before <- assertActivePool fixture initialized.poolCid
  Some position <- queryContractId fixture.provider initialized.positionCid
  treasuryHoldingCid <- issueTreasury fixture fixture.provider (amountOf 1000000)
  stableHoldingCid <- issueStable fixture fixture.provider (amountOf 1000000)

  submitMustFail fixture.provider $ exerciseCmd initialized.poolCid AddLiquidity with
    provider = fixture.provider
    treasuryHoldingCid
    stableHoldingCid
    maximumTreasury = amountOf 1000000
    maximumStable = amountOf 1000000
    minimumShares = 0.0
    expectedVersion = before.stateVersion

  submitMustFail fixture.provider $ exerciseCmd initialized.poolCid RemoveLiquidity with
    provider = fixture.provider
    positionCid = initialized.positionCid
    burnShares = amountOf 1000
    minimumTreasuryOut = 0.0
    minimumStableOut = 0.0
    expectedVersion = before.stateVersion

  after <- assertActivePool fixture initialized.poolCid
  after === before
  Some positionAfter <- queryContractId fixture.provider initialized.positionCid
  positionAfter === position
  Some treasuryHolding <- queryContractId fixture.provider treasuryHoldingCid
  Some stableHolding <- queryContractId fixture.provider stableHoldingCid
  atomsOf treasuryHolding.amount === 1000000
  atomsOf stableHolding.amount === 1000000
  assertPoolReservesMatch fixture initialized.poolCid

  added <- submitAddLiquidity fixture initialized.poolCid fixture.provider
    treasuryHoldingCid stableHoldingCid (amountOf 1000000) (amountOf 1000000) 0.0
  atomsOf added.mintedShares === 707106
  _ <- submitRemoveLiquidity fixture added.poolCid fixture.provider added.positionCid
    added.mintedShares 0.0 0.0
  pure ()

-- Characterizes CURRENT BEHAVIOUR of `BurnPosition` exercised outside `RemoveLiquidity`.
-- Actor: the genuine provider, burning its own position. Required authority: the provider
-- alone, as the choice controller; no Pool choice, disclosure, operator or governance is needed.
-- Initial state: a legitimate pool whose only circulating shares are the provider's position.
-- Action: a partial direct burn, then a direct burn of the remainder.
-- Assets affected: none move; no payout occurs. Pool/LP state affected: outstanding positions
-- shrink while the Pool's recorded `totalShares` stays unchanged.
-- Verified outcome: the provider forfeits its claim without compensation and the Pool's supply
-- no longer reconciles with outstanding positions. The reserves backing the burned shares stay
-- in the pool with no position able to redeem them. This is a self-inflicted loss and a
-- supply-accounting inconsistency, not theft by an unrelated party.
-- Limitation: does not show how later LPs mint or redeem against the unreconciled supply, or
-- who could eventually capture the stranded value, nor any interaction with forged positions.
directPositionBurnLeavesPoolSupplyUnchanged : Script ()
directPositionBurnLeavesPoolSupplyUnchanged = do
  Initialized {fixture, initialized} <- standardPool
  poolBefore <- assertActivePool fixture initialized.poolCid
  Some positionBefore <- queryContractId fixture.provider initialized.positionCid
  let providerShareAtoms = atomsOf positionBefore.shares
  providerShareAtoms === atomsOf poolBefore.totalShares - lockedSharesAtoms
  Some treasuryReserveBefore <- queryContractId fixture.operator poolBefore.treasuryReserveHoldingCid
  Some stableReserveBefore <- queryContractId fixture.operator poolBefore.stableReserveHoldingCid
  providerHoldingsBefore <- query @Holding fixture.provider
  treasuryTotalBefore <- instrumentTotalAtoms fixture fixture.treasuryInstrument
  stableTotalBefore <- instrumentTotalAtoms fixture fixture.stableInstrument

  let partialBurnAtoms = providerShareAtoms / 2
  partial <- submit fixture.provider $ exerciseCmd initialized.positionCid BurnPosition with
    expectedPoolId = poolBefore.poolId
    burnAmount = amountOf partialBurnAtoms
  burnedPosition <- queryContractId fixture.provider initialized.positionCid
  burnedPosition === None
  Some remainingCid <- pure partial.remainingPositionCid
  Some remaining <- queryContractId fixture.provider remainingCid
  atomsOf remaining.shares === providerShareAtoms - partialBurnAtoms
  poolAfterPartial <- assertActivePool fixture initialized.poolCid
  poolAfterPartial === poolBefore
  assert (atomsOf remaining.shares + lockedSharesAtoms < atomsOf poolAfterPartial.totalShares)

  full <- submit fixture.provider $ exerciseCmd remainingCid BurnPosition with
    expectedPoolId = poolBefore.poolId
    burnAmount = remaining.shares
  full.remainingPositionCid === None
  positions <- query @LiquidityPosition fixture.provider
  positions === []

  poolAfter <- assertActivePool fixture initialized.poolCid
  poolAfter === poolBefore
  atomsOf poolAfter.totalShares === providerShareAtoms + lockedSharesAtoms
  Some treasuryReserveAfter <- queryContractId fixture.operator poolBefore.treasuryReserveHoldingCid
  treasuryReserveAfter === treasuryReserveBefore
  Some stableReserveAfter <- queryContractId fixture.operator poolBefore.stableReserveHoldingCid
  stableReserveAfter === stableReserveBefore
  assertPoolReservesMatch fixture initialized.poolCid
  providerHoldingsAfter <- query @Holding fixture.provider
  providerHoldingsAfter === providerHoldingsBefore
  treasuryTotalAfter <- instrumentTotalAtoms fixture fixture.treasuryInstrument
  treasuryTotalAfter === treasuryTotalBefore
  stableTotalAfter <- instrumentTotalAtoms fixture fixture.stableInstrument
  stableTotalAfter === stableTotalBefore
