-- Secure V1 AMM: live protected reserves, an authenticated pool state and authenticated LP
-- positions. These templates run in parallel with the legacy `Pool`, `PoolSetup` and
-- `LiquidityPosition`, which keep their original trust model and are not protected by anything
-- here. `SECURE_V1.md` in this package records the trust model, privacy and migration impact.
--
-- Authorization: every charter, pool state and reserve is signed by the custodian, the operator
-- and both instrument issuers (the core signers), which must be distinct from each other and
-- from governance; positions are also signed by their provider. Reserves have no choices of
-- their own. They change only inside the pool choices below and the paused pool's withdrawal in
-- `CantonTreasuryAmm.SecureV1.Pause`, which archive each consumed reserve and create its
-- successor with the pool's own signatory authority, so value leaves a reserve only through a
-- pool transition that accounts for it. Pause and resume move no reserve. No strict subset of the
-- core can move, archive or create a reserve, pool state or position. The full core coalition
-- can, and is trusted; the custodian is assumed independent.
--
-- Asset model: reserves are `SecureReserveHolding`s, which the issuers must adopt and co-sign.
-- An ordinary `Holding` cannot be a protected reserve (its issuer alone can archive it and its
-- owner alone can move it). Deposits convert ordinary holdings into reserve value: the
-- depositor's own `TransferExact` moves the holding to the custodian and the issuer's authority
-- retires it. Payouts are new ordinary holdings. This is issuer-authorized ledger accounting;
-- nothing here evidences off-ledger backing. Arbitrary Token Standard holdings are unsupported.
--
-- Identity: pool states, reserves and positions carry `genesisCid`, the consumed charter's
-- contract ID. A pool accepts only reserves of its own lineage and genesis and redeems only
-- positions of its own lineage and genesis.
module CantonTreasuryAmm.SecureV1.Pool where

import DA.List (dedupSort, unique)
import DA.TextMap qualified as TextMap

import Splice.Api.Token.HoldingV1 qualified as TokenStandard
import Splice.Api.Token.MetadataV1 (Metadata (..))

import CantonTreasuryAmm.Errors
import CantonTreasuryAmm.Math
import CantonTreasuryAmm.Pool (validateSwap)
import CantonTreasuryAmm.Token
import CantonTreasuryAmm.Types

data SecureLineage = SecureLineage with
  custodian : Party
  operator : Party
  governance : Party
  treasuryInstrument : InstrumentId
  stableInstrument : InstrumentId
  charterReference : Text
    deriving (Eq, Show)

coreSignatories : SecureLineage -> [Party]
coreSignatories lineage =
  [lineage.custodian, lineage.operator, lineage.treasuryInstrument.issuer, lineage.stableInstrument.issuer]

secureLineageIsIndependent : SecureLineage -> Bool
secureLineageIsIndependent lineage =
  lineage.treasuryInstrument /= lineage.stableInstrument
    && unique (lineage.governance :: coreSignatories lineage)

data SecureInitializeResult = SecureInitializeResult with
  poolCid : ContractId SecurePool
  positionCid : ContractId SecureLiquidityPosition
  treasuryChangeHoldingCid : Optional (ContractId Holding)
  stableChangeHoldingCid : Optional (ContractId Holding)
    deriving (Eq, Show)

data SecureSwapResult = SecureSwapResult with
  poolCid : ContractId SecurePool
  outputHoldingCid : ContractId Holding
  inputChangeHoldingCid : Optional (ContractId Holding)
  amountOut : Decimal
    deriving (Eq, Show)

data SecureAddLiquidityResult = SecureAddLiquidityResult with
  poolCid : ContractId SecurePool
  positionCid : ContractId SecureLiquidityPosition
  treasuryChangeHoldingCid : Optional (ContractId Holding)
  stableChangeHoldingCid : Optional (ContractId Holding)
  mintedShares : Decimal
  usedTreasury : Decimal
  usedStable : Decimal
    deriving (Eq, Show)

data SecureRemoveLiquidityResult = SecureRemoveLiquidityResult with
  poolCid : ContractId SecurePool
  remainingPositionCid : Optional (ContractId SecureLiquidityPosition)
  treasuryOutputHoldingCid : Optional (ContractId Holding)
  stableOutputHoldingCid : Optional (ContractId Holding)
  treasuryOut : Decimal
  stableOut : Decimal
    deriving (Eq, Show)

-- A live, protected pool reserve. It has no choices: only a contract carrying all four core
-- signatures can archive or create one, and the only such contracts here are the charter and
-- the active and paused pool states (the pause and resume proposals carry all four signatures but
-- only archive and recreate a pool state, never a reserve). `auditors` are the holding auditors of the deposits it absorbed, exactly as a
-- legacy operator-owned reserve `Holding` carries them; they observe but cannot act.
template SecureReserveHolding
  with
    lineage : SecureLineage
    genesisCid : ContractId SecurePoolCharter
    instrument : InstrumentId
    amount : Decimal
    auditors : [Party]
  where
    signatory coreSignatories lineage
    observer lineage.governance, auditors
    ensure
      isPositiveCapped amount
        && (instrument == lineage.treasuryInstrument || instrument == lineage.stableInstrument)
        && secureLineageIsIndependent lineage

    -- The view adds no movement path: the standard interface declares no choices. The custodian
    -- is reported as owner and every party whose authority a movement needs as a lock holder.
    -- Like the legacy holding view, it omits `auditors`.
    interface instance TokenStandard.Holding for SecureReserveHolding where
      view = TokenStandard.HoldingView with
        owner = lineage.custodian
        instrumentId = standardInstrumentId instrument
        amount
        lock = Some TokenStandard.Lock with
          holders = coreSignatories lineage
          expiresAt = None
          expiresAfter = None
          context = Some "AMM pool reserve; moves only through pool settlement"
        meta = Metadata with
          values = TextMap.fromList [("canton-treasury-amm/charter-reference", lineage.charterReference)]

-- The pool's genesis. Consuming it is the only way to create the first reserves, state and
-- position of a lineage; the core signers create one charter per intended pool.
template SecurePoolCharter
  with
    lineage : SecureLineage
    initialProvider : Party
    auditors : [Party]
  where
    signatory coreSignatories lineage
    observer initialProvider, lineage.governance, auditors
    ensure secureLineageIsIndependent lineage

    choice InitializePool : SecureInitializeResult
      with
        treasuryHoldingCid : ContractId Holding
        stableHoldingCid : ContractId Holding
        treasuryAmount : Decimal
        stableAmount : Decimal
      controller initialProvider
      do
        treasuryHolding <- fetch treasuryHoldingCid
        stableHolding <- fetch stableHoldingCid
        requireDomain (treasuryAmount > 0.0 && stableAmount > 0.0) invalidAmountError "Initial deposits must be positive"
        requireDomain (treasuryAmount <= maxReserveAmount && stableAmount <= maxReserveAmount) reserveCapError "Initial reserve exceeds the atom cap"
        let treasuryAtoms = atomsOf treasuryAmount
        let stableAtoms = atomsOf stableAmount
        requireDomain (treasuryHolding.instrument == lineage.treasuryInstrument) instrumentMismatchError "Treasury holding uses the wrong instrument"
        requireDomain (stableHolding.instrument == lineage.stableInstrument) instrumentMismatchError "Stablecoin holding uses the wrong instrument"
        requireDomain (treasuryHolding.owner == initialProvider) ownerMismatchError "Initial provider does not own the Treasury holding"
        requireDomain (stableHolding.owner == initialProvider) ownerMismatchError "Initial provider does not own the stablecoin holding"
        requireState (treasuryAtoms <= atomsOf treasuryHolding.amount) insufficientBalanceError "Treasury deposit exceeds the holding balance"
        requireState (stableAtoms <= atomsOf stableHolding.amount) insufficientBalanceError "Stablecoin deposit exceeds the holding balance"
        let grossShares = floorSqrtWide (wide treasuryAtoms * wide stableAtoms)
        requireDomain (grossShares >= minimumInitialSharesAtoms) initialLiquidityError "Initial liquidity is below the minimum share threshold"
        let providerShares = grossShares - lockedSharesAtoms
        requireDomain (providerShares > 0) initialLiquidityError "Initial liquidity does not leave provider shares"
        treasuryChangeHoldingCid <- retireDeposit lineage.custodian treasuryHoldingCid treasuryAtoms
        stableChangeHoldingCid <- retireDeposit lineage.custodian stableHoldingCid stableAtoms
        treasuryReserveCid <- create SecureReserveHolding with
          lineage
          genesisCid = self
          instrument = lineage.treasuryInstrument
          amount = amountOf treasuryAtoms
          auditors = treasuryHolding.auditors
        stableReserveCid <- create SecureReserveHolding with
          lineage
          genesisCid = self
          instrument = lineage.stableInstrument
          amount = amountOf stableAtoms
          auditors = stableHolding.auditors
        poolCid <- create SecurePool with
          lineage
          genesisCid = self
          auditors
          treasuryReserveCid
          stableReserveCid
          treasuryReserveAmount = amountOf treasuryAtoms
          stableReserveAmount = amountOf stableAtoms
          totalShares = amountOf grossShares
          lockedShares = amountOf lockedSharesAtoms
          treasuryFeeAmount = 0.0
          stableFeeAmount = 0.0
          stateVersion = 0
        positionCid <- create SecureLiquidityPosition with
          lineage
          genesisCid = self
          provider = initialProvider
          shares = amountOf providerShares
          auditors
        pure SecureInitializeResult with poolCid; positionCid; treasuryChangeHoldingCid; stableChangeHoldingCid

-- The authenticated pool state. It records the reserve amounts and fee counters with the same
-- meaning as the legacy `Pool`, and every choice first checks the recorded amounts against the
-- live reserves it references.
template SecurePool
  with
    lineage : SecureLineage
    genesisCid : ContractId SecurePoolCharter
    auditors : [Party]
    treasuryReserveCid : ContractId SecureReserveHolding
    stableReserveCid : ContractId SecureReserveHolding
    treasuryReserveAmount : Decimal
    stableReserveAmount : Decimal
    totalShares : Decimal
    lockedShares : Decimal
    treasuryFeeAmount : Decimal
    stableFeeAmount : Decimal
    stateVersion : Int
  where
    signatory coreSignatories lineage
    observer lineage.governance, auditors
    ensure
      isPositiveCapped treasuryReserveAmount
        && isPositiveCapped stableReserveAmount
        && totalShares >= lockedShares
        && totalShares <= maxReserveAmount
        && lockedShares == amountOf lockedSharesAtoms
        && isNonNegativeCapped treasuryFeeAmount
        && isNonNegativeCapped stableFeeAmount
        && secureLineageIsIndependent lineage

    choice SwapExactInput : SecureSwapResult
      with
        trader : Party
        direction : SwapDirection
        inputHoldingCid : ContractId Holding
        inputAmount : Decimal
        minimumAmountOut : Decimal
        deadline : Time
        expectedVersion : Int
      controller trader
      do
        (treasuryReserve, stableReserve) <- validateSecurePool this expectedVersion
        inputHolding <- fetch inputHoldingCid
        now <- getTime
        requireState (now < deadline) deadlineError "Swap deadline has expired"
        requireDomain (inputAmount > 0.0 && minimumAmountOut >= 0.0) invalidAmountError "Swap amounts must be positive or zero as required"
        requireDomain (inputAmount <= maxReserveAmount && minimumAmountOut <= maxReserveAmount) reserveCapError "Swap amount exceeds the atom cap"
        let inputAtoms = atomsOf inputAmount
        let ((inputReserveCid, inputReserve), (outputReserveCid, outputReserve)) = case direction of
              TreasuryForStable -> ((treasuryReserveCid, treasuryReserve), (stableReserveCid, stableReserve))
              StableForTreasury -> ((stableReserveCid, stableReserve), (treasuryReserveCid, treasuryReserve))
        requireDeposit inputReserve trader inputHolding
        let reserveInAtoms = atomsOf inputReserve.amount
        let reserveOutAtoms = atomsOf outputReserve.amount
        requireDomain (reserveInAtoms + inputAtoms <= maxReserveAtoms) reserveCapError "Input reserve would exceed the atom cap"
        let outputAtoms = swapOutputAtoms reserveInAtoms reserveOutAtoms inputAtoms
        validateSwap reserveInAtoms reserveOutAtoms inputAtoms outputAtoms (atomsOf minimumAmountOut)
        (inputChangeHoldingCid, nextInputReserveCid) <- absorbDeposit lineage.custodian inputReserveCid inputReserve inputHoldingCid inputAtoms
        (outputHoldingCid, nextOutputReserveCid) <- disburseReserve outputReserveCid outputReserve trader outputAtoms
        let feeAtoms = feeAtomsFor inputAtoms
        poolCid <- case direction of
          TreasuryForStable -> create this with
            treasuryReserveCid = nextInputReserveCid
            stableReserveCid = nextOutputReserveCid
            treasuryReserveAmount = amountOf (reserveInAtoms + inputAtoms)
            stableReserveAmount = amountOf (reserveOutAtoms - outputAtoms)
            treasuryFeeAmount = creditReportingFee treasuryFeeAmount feeAtoms
            stateVersion = stateVersion + 1
          StableForTreasury -> create this with
            treasuryReserveCid = nextOutputReserveCid
            stableReserveCid = nextInputReserveCid
            treasuryReserveAmount = amountOf (reserveOutAtoms - outputAtoms)
            stableReserveAmount = amountOf (reserveInAtoms + inputAtoms)
            stableFeeAmount = creditReportingFee stableFeeAmount feeAtoms
            stateVersion = stateVersion + 1
        pure SecureSwapResult with
          poolCid
          outputHoldingCid
          inputChangeHoldingCid
          amountOut = amountOf outputAtoms

    choice AddLiquidity : SecureAddLiquidityResult
      with
        provider : Party
        treasuryHoldingCid : ContractId Holding
        stableHoldingCid : ContractId Holding
        maximumTreasury : Decimal
        maximumStable : Decimal
        minimumShares : Decimal
        expectedVersion : Int
      controller provider
      do
        (treasuryReserve, stableReserve) <- validateSecurePool this expectedVersion
        treasuryHolding <- fetch treasuryHoldingCid
        stableHolding <- fetch stableHoldingCid
        requireDeposit treasuryReserve provider treasuryHolding
        requireDeposit stableReserve provider stableHolding
        requireDomain (maximumTreasury > 0.0 && maximumStable > 0.0 && minimumShares >= 0.0) invalidAmountError "Liquidity amounts must be positive or zero as required"
        requireDomain (maximumTreasury <= maxReserveAmount && maximumStable <= maxReserveAmount && minimumShares <= maxReserveAmount) reserveCapError "Liquidity amount exceeds the atom cap"
        let maximumTreasuryAtoms = atomsOf maximumTreasury
        let maximumStableAtoms = atomsOf maximumStable
        let minimumShareAtoms = atomsOf minimumShares
        requireState (maximumTreasuryAtoms <= atomsOf treasuryHolding.amount) insufficientBalanceError "Treasury maximum exceeds the holding balance"
        requireState (maximumStableAtoms <= atomsOf stableHolding.amount) insufficientBalanceError "Stablecoin maximum exceeds the holding balance"
        let treasuryReserveAtoms = atomsOf treasuryReserveAmount
        let stableReserveAtoms = atomsOf stableReserveAmount
        let totalShareAtoms = atomsOf totalShares
        treasuryLimitedShares <- narrowAtoms (wideMulFloor maximumTreasuryAtoms totalShareAtoms treasuryReserveAtoms)
        stableLimitedShares <- narrowAtoms (wideMulFloor maximumStableAtoms totalShareAtoms stableReserveAtoms)
        let mintedShareAtoms = min treasuryLimitedShares stableLimitedShares
        requireState (mintedShareAtoms > 0) insufficientLiquidityError "Contribution mints no shares"
        requireDomain (mintedShareAtoms >= minimumShareAtoms) slippageError "Minted shares are below the provider minimum"
        usedTreasuryAtoms <- narrowAtoms (wideMulCeil mintedShareAtoms treasuryReserveAtoms totalShareAtoms)
        usedStableAtoms <- narrowAtoms (wideMulCeil mintedShareAtoms stableReserveAtoms totalShareAtoms)
        -- mintedShareAtoms <= floor(maximum * supply / reserve) forces ceil(minted * reserve / supply) <= maximum.
        assertMsg "Required contribution cannot exceed its maximum"
          (usedTreasuryAtoms <= maximumTreasuryAtoms && usedStableAtoms <= maximumStableAtoms)
        requireDomain (treasuryReserveAtoms + usedTreasuryAtoms <= maxReserveAtoms) reserveCapError "Treasury reserve would exceed the atom cap"
        requireDomain (stableReserveAtoms + usedStableAtoms <= maxReserveAtoms) reserveCapError "Stablecoin reserve would exceed the atom cap"
        requireDomain (totalShareAtoms + mintedShareAtoms <= maxReserveAtoms) reserveCapError "LP supply would exceed the atom cap"
        (treasuryChangeHoldingCid, nextTreasuryReserveCid) <-
          absorbDeposit lineage.custodian treasuryReserveCid treasuryReserve treasuryHoldingCid usedTreasuryAtoms
        (stableChangeHoldingCid, nextStableReserveCid) <-
          absorbDeposit lineage.custodian stableReserveCid stableReserve stableHoldingCid usedStableAtoms
        poolCid <- create this with
          treasuryReserveCid = nextTreasuryReserveCid
          stableReserveCid = nextStableReserveCid
          treasuryReserveAmount = amountOf (treasuryReserveAtoms + usedTreasuryAtoms)
          stableReserveAmount = amountOf (stableReserveAtoms + usedStableAtoms)
          totalShares = amountOf (totalShareAtoms + mintedShareAtoms)
          stateVersion = stateVersion + 1
        positionCid <- create SecureLiquidityPosition with
          lineage
          genesisCid
          provider
          shares = amountOf mintedShareAtoms
          auditors
        pure SecureAddLiquidityResult with
          poolCid
          positionCid
          treasuryChangeHoldingCid
          stableChangeHoldingCid
          mintedShares = amountOf mintedShareAtoms
          usedTreasury = amountOf usedTreasuryAtoms
          usedStable = amountOf usedStableAtoms

    choice RemoveLiquidity : SecureRemoveLiquidityResult
      with
        provider : Party
        positionCid : ContractId SecureLiquidityPosition
        burnShares : Decimal
        minimumTreasuryOut : Decimal
        minimumStableOut : Decimal
        expectedVersion : Int
      controller provider
      do
        (treasuryReserve, stableReserve) <- validateSecurePool this expectedVersion
        redemption <- redeemPosition (accountsOf this) treasuryReserve stableReserve provider positionCid
          burnShares minimumTreasuryOut minimumStableOut
        poolCid <- create this with
          treasuryReserveCid = redemption.nextTreasuryReserveCid
          stableReserveCid = redemption.nextStableReserveCid
          treasuryReserveAmount = redemption.nextTreasuryReserveAmount
          stableReserveAmount = redemption.nextStableReserveAmount
          totalShares = redemption.nextTotalShares
          stateVersion = stateVersion + 1
        pure SecureRemoveLiquidityResult with
          poolCid
          remainingPositionCid = redemption.remainingPositionCid
          treasuryOutputHoldingCid = redemption.treasuryOutputHoldingCid
          stableOutputHoldingCid = redemption.stableOutputHoldingCid
          treasuryOut = redemption.treasuryOut
          stableOut = redemption.stableOut

-- An LP entitlement with no choices. It changes only inside `RemoveLiquidity`, which pays its
-- share of both reserves; its implicit `Archive` needs the provider and all four core signers.
template SecureLiquidityPosition
  with
    lineage : SecureLineage
    genesisCid : ContractId SecurePoolCharter
    provider : Party
    shares : Decimal
    auditors : [Party]
  where
    signatory provider :: coreSignatories lineage
    observer lineage.governance, auditors
    ensure isPositiveCapped shares && secureLineageIsIndependent lineage

-- The reserve and LP accounting a pool state records, shared by the active state and the paused
-- state (`CantonTreasuryAmm.SecureV1.Pause`), which carry the same fields.
data SecurePoolAccounts = SecurePoolAccounts with
    lineage : SecureLineage
    genesisCid : ContractId SecurePoolCharter
    treasuryReserveCid : ContractId SecureReserveHolding
    stableReserveCid : ContractId SecureReserveHolding
    treasuryReserveAmount : Decimal
    stableReserveAmount : Decimal
    totalShares : Decimal
    lockedShares : Decimal
    stateVersion : Int
  deriving (Eq, Show)

accountsOf : SecurePool -> SecurePoolAccounts
accountsOf pool = SecurePoolAccounts with
  lineage = pool.lineage
  genesisCid = pool.genesisCid
  treasuryReserveCid = pool.treasuryReserveCid
  stableReserveCid = pool.stableReserveCid
  treasuryReserveAmount = pool.treasuryReserveAmount
  stableReserveAmount = pool.stableReserveAmount
  totalShares = pool.totalShares
  lockedShares = pool.lockedShares
  stateVersion = pool.stateVersion

-- Checks the expected version, that both referenced reserves are live reserves of this pool's
-- lineage, genesis and instrument, and that the recorded amounts equal them.
validateSecurePool : SecurePool -> Int -> Update (SecureReserveHolding, SecureReserveHolding)
validateSecurePool pool = validatePoolAccounts (accountsOf pool)

validatePoolAccounts : SecurePoolAccounts -> Int -> Update (SecureReserveHolding, SecureReserveHolding)
validatePoolAccounts accounts expectedVersion = do
  requireState (accounts.stateVersion == expectedVersion) staleStateError "Pool state version is stale"
  treasuryReserve <- fetch accounts.treasuryReserveCid
  stableReserve <- fetch accounts.stableReserveCid
  requireState (reserveBelongsToAccounts accounts accounts.lineage.treasuryInstrument treasuryReserve) reserveMismatchError "Treasury reserve does not belong to this pool"
  requireState (reserveBelongsToAccounts accounts accounts.lineage.stableInstrument stableReserve) reserveMismatchError "Stablecoin reserve does not belong to this pool"
  requireState (treasuryReserve.amount == accounts.treasuryReserveAmount) reserveMismatchError "Treasury reserve amount does not match the pool"
  requireState (stableReserve.amount == accounts.stableReserveAmount) reserveMismatchError "Stablecoin reserve amount does not match the pool"
  pure (treasuryReserve, stableReserve)

reserveBelongsTo : SecurePool -> InstrumentId -> SecureReserveHolding -> Bool
reserveBelongsTo pool = reserveBelongsToAccounts (accountsOf pool)

reserveBelongsToAccounts : SecurePoolAccounts -> InstrumentId -> SecureReserveHolding -> Bool
reserveBelongsToAccounts accounts instrument reserve =
  reserve.lineage == accounts.lineage && reserve.genesisCid == accounts.genesisCid && reserve.instrument == instrument

data SecureRedemption = SecureRedemption with
    remainingPositionCid : Optional (ContractId SecureLiquidityPosition)
    treasuryOutputHoldingCid : Optional (ContractId Holding)
    stableOutputHoldingCid : Optional (ContractId Holding)
    treasuryOut : Decimal
    stableOut : Decimal
    nextTreasuryReserveCid : ContractId SecureReserveHolding
    nextStableReserveCid : ContractId SecureReserveHolding
    nextTreasuryReserveAmount : Decimal
    nextStableReserveAmount : Decimal
    nextTotalShares : Decimal
  deriving (Eq, Show)

-- Redeems `burnShares` of the provider's position of this pool for its pro-rata share of both
-- validated reserves, rounding the payouts down: the locked share is never burnt, the position
-- is archived and any remainder recreated, and the provider is paid from the reserves. The
-- caller creates the successor pool state from the result; this is the only redemption path of
-- both the active and the paused state.
redeemPosition : SecurePoolAccounts -> SecureReserveHolding -> SecureReserveHolding -> Party -> ContractId SecureLiquidityPosition -> Decimal -> Decimal -> Decimal -> Update SecureRedemption
redeemPosition accounts treasuryReserve stableReserve provider positionCid burnShares minimumTreasuryOut minimumStableOut = do
  position <- fetch positionCid
  requireDomain (position.lineage == accounts.lineage && position.genesisCid == accounts.genesisCid) positionError "Liquidity position belongs to another pool"
  requireDomain (position.provider == provider) ownerMismatchError "Provider does not own the liquidity position"
  requireDomain (burnShares > 0.0 && minimumTreasuryOut >= 0.0 && minimumStableOut >= 0.0) invalidAmountError "Removal amounts must be positive or zero as required"
  requireDomain (burnShares <= maxReserveAmount && minimumTreasuryOut <= maxReserveAmount && minimumStableOut <= maxReserveAmount) reserveCapError "Removal amount exceeds the atom cap"
  let burnShareAtoms = atomsOf burnShares
  let totalShareAtoms = atomsOf accounts.totalShares
  let lockedShareAtoms = atomsOf accounts.lockedShares
  requireState (burnShareAtoms <= totalShareAtoms - lockedShareAtoms) positionError "Burn would consume locked shares"
  let treasuryReserveAtoms = atomsOf accounts.treasuryReserveAmount
  let stableReserveAtoms = atomsOf accounts.stableReserveAmount
  treasuryOutputAtoms <- narrowAtoms (wideMulFloor burnShareAtoms treasuryReserveAtoms totalShareAtoms)
  stableOutputAtoms <- narrowAtoms (wideMulFloor burnShareAtoms stableReserveAtoms totalShareAtoms)
  requireState (treasuryOutputAtoms > 0 || stableOutputAtoms > 0) insufficientLiquidityError "Burn produces no output"
  requireDomain (treasuryOutputAtoms >= atomsOf minimumTreasuryOut && stableOutputAtoms >= atomsOf minimumStableOut) slippageError "Liquidity output is below its minimum"
  let positionShareAtoms = atomsOf position.shares
  requireState (burnShareAtoms <= positionShareAtoms) positionError "Burn amount exceeds the position"
  archive positionCid
  remainingPositionCid <-
    if burnShareAtoms == positionShareAtoms
      then pure None
      else Some <$> create position with shares = amountOf (positionShareAtoms - burnShareAtoms)
  (treasuryOutputHoldingCid, nextTreasuryReserveCid) <-
    disburseIfPositive accounts.treasuryReserveCid treasuryReserve provider treasuryOutputAtoms
  (stableOutputHoldingCid, nextStableReserveCid) <-
    disburseIfPositive accounts.stableReserveCid stableReserve provider stableOutputAtoms
  pure SecureRedemption with
    remainingPositionCid
    treasuryOutputHoldingCid
    stableOutputHoldingCid
    treasuryOut = amountOf treasuryOutputAtoms
    stableOut = amountOf stableOutputAtoms
    nextTreasuryReserveCid
    nextStableReserveCid
    nextTreasuryReserveAmount = amountOf (treasuryReserveAtoms - treasuryOutputAtoms)
    nextStableReserveAmount = amountOf (stableReserveAtoms - stableOutputAtoms)
    nextTotalShares = amountOf (totalShareAtoms - burnShareAtoms)

-- A deposit must be the depositor's own holding of the reserve's instrument and disclose to the
-- same auditors, the condition the legacy pool's reserve `Merge` imposes.
requireDeposit : SecureReserveHolding -> Party -> Holding -> Update ()
requireDeposit reserve depositor holding = do
  requireDomain (holding.instrument == reserve.instrument) instrumentMismatchError "Deposit uses the wrong instrument"
  requireDomain (holding.owner == depositor) ownerMismatchError "Depositor does not own the deposit holding"
  requireDomain (dedupSort holding.auditors == dedupSort reserve.auditors) incompatibleHoldingsError
    "Deposit discloses to different auditors than the reserve"

-- Moves `atoms` of the depositor's holding to the custodian and retires the moved part. The
-- move is the owner-controlled `TransferExact`, so it needs the depositor's own authority even
-- inside a choice carrying the core signers' authority.
retireDeposit : Party -> ContractId Holding -> Int -> Update (Optional (ContractId Holding))
retireDeposit custodian holdingCid atoms = do
  transfer <- exercise holdingCid TransferExact with
    newOwner = custodian
    transferAmount = amountOf atoms
  archive transfer.movedHoldingCid
  pure transfer.changeHoldingCid

replaceReserve : ContractId SecureReserveHolding -> SecureReserveHolding -> Int -> Update (ContractId SecureReserveHolding)
replaceReserve reserveCid reserve atoms = do
  archive reserveCid
  create reserve with amount = amountOf atoms

absorbDeposit : Party -> ContractId SecureReserveHolding -> SecureReserveHolding -> ContractId Holding -> Int -> Update (Optional (ContractId Holding), ContractId SecureReserveHolding)
absorbDeposit custodian reserveCid reserve holdingCid atoms = do
  changeHoldingCid <- retireDeposit custodian holdingCid atoms
  nextReserveCid <- replaceReserve reserveCid reserve (atomsOf reserve.amount + atoms)
  pure (changeHoldingCid, nextReserveCid)

-- Pays `payoutAtoms` from the reserve as a new ordinary holding that discloses to the reserve's
-- auditors, as a transfer out of a legacy reserve holding does. A payout never empties a reserve.
disburseReserve : ContractId SecureReserveHolding -> SecureReserveHolding -> Party -> Int -> Update (ContractId Holding, ContractId SecureReserveHolding)
disburseReserve reserveCid reserve recipient payoutAtoms = do
  let reserveAtoms = atomsOf reserve.amount
  requireState (payoutAtoms > 0 && payoutAtoms < reserveAtoms) insufficientLiquidityError "Payout is empty or exhausts its reserve"
  payoutCid <- create Holding with
    instrument = reserve.instrument
    owner = recipient
    amount = amountOf payoutAtoms
    auditors = reserve.auditors
  nextReserveCid <- replaceReserve reserveCid reserve (reserveAtoms - payoutAtoms)
  pure (payoutCid, nextReserveCid)

disburseIfPositive : ContractId SecureReserveHolding -> SecureReserveHolding -> Party -> Int -> Update (Optional (ContractId Holding), ContractId SecureReserveHolding)
disburseIfPositive reserveCid reserve recipient payoutAtoms =
  if payoutAtoms == 0
    then pure (None, reserveCid)
    else do
      (payoutCid, nextReserveCid) <- disburseReserve reserveCid reserve recipient payoutAtoms
      pure (Some payoutCid, nextReserveCid)
